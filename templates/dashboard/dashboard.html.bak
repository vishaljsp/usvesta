        function deleteContactMsg(msgId, btn) {
            if (!confirm("Delete this contact message?")) return;
            let csrf_token = document.querySelector("[name='csrfmiddlewaretoken']").value;
            let formData = new FormData();
            formData.append("contact_action", "delete");
            formData.append("contact_id", msgId);
            
            fetch("/usvesta-deshboard", {
                method: "POST",
                body: formData,
                headers: { "X-CSRFToken": csrf_token }
            })
            .then(res => res.json())
            .then(data => {
                swal({ text: data.res, icon: "success" }).then(() => {
                    btn.closest("tr").remove();
                });
            });
        }

        function toggleReviewShow(reviewId, checkbox) {
            let csrf_token = document.querySelector("[name='csrfmiddlewaretoken']").value;
            let formData = new FormData();
            formData.append("toggle_review_id", reviewId);
            
            fetch("/usvesta-deshboard", {
                method: "POST",
                body: formData,
                headers: { "X-CSRFToken": csrf_token }
            })
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    swal({ text: data.error, icon: "error" });
                    checkbox.checked = !checkbox.checked; // revert
                } else {
                    // Show small subtle toast confirmation
                    swal({ text: data.res, icon: "success", timer: 1200, buttons: false });
                }
            })
            .catch(err => {
                console.error(err);
                checkbox.checked = !checkbox.checked; // revert
            });
        }

        function showNotificationDetails(title, message) {
            swal({
                title: title,
                text: message,
                icon: "info",
                button: "Close"
            });
        }

        function filterOrdersByStatus(status, element) {
            // Update active link styling
            document.querySelectorAll("#orderStatusTabs .nav-link").forEach(link => {
                link.classList.remove("active", "text-dark", "fw-bold");
                link.classList.add("text-muted");
            });
            element.classList.add("active", "text-dark", "fw-bold");
            element.classList.remove("text-muted");
            
            let rows = document.querySelectorAll("#order_session tbody tr");
            rows.forEach(row => {
                let rowStatus = row.getAttribute("data-status");
                if (!rowStatus) return;
                rowStatus = rowStatus.toLowerCase();
                
                if (status === 'all') {
                    row.style.display = "";
                } else if (status === 'ordered') {
                    if (rowStatus === 'ordered' || rowStatus === 'pending') {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                } else if (rowStatus === status.toLowerCase()) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }
    </script>

</body>

</html>