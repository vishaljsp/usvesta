    </div>

    <!-- Add Blog Category Modal -->
    <div class="modal fade" id="addBlogCategoryModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Blog Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form onsubmit="event.preventDefault(); submitBlogCategoryForm(this);">
                        {% csrf_token %}
                        <input type="hidden" name="blog_cat_action" value="add">
                        <div class="mb-3">
                            <label class="form-label">Category Name</label>
                            <input type="text" name="blog_category_name" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-premium btn-premium-primary w-100">Create Category</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Blog Post Modal -->
    <div class="modal fade" id="addBlogPostModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Blog Post</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height: calc(100vh - 200px); overflow-y: auto;">
                    <form enctype="multipart/form-data" onsubmit="event.preventDefault(); submitBlogPostForm(this);">
                        {% csrf_token %}
                        <input type="hidden" name="blog_post_action" value="add">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Blog Title</label>
                                    <input type="text" name="blog_title" class="form-control" required placeholder="Meta Title">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Author Name</label>
                                    <input type="text" name="blog_author" class="form-control" required value="US Vesta Editor">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Category</label>
                                    <select name="blog_category" class="form-select" required>
                                        {% for cat in blog_categories %}
                                        <option value="{{ cat.id }}">{{ cat.category }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Blog Main Image</label>
                                    <input type="file" name="blog_image" accept="image/*" class="form-control" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Image Alt Name</label>
                                    <input type="text" name="blog_alt" class="form-control" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Meta Keywords</label>
                                    <input type="text" name="blog_keyword" class="form-control" placeholder="Comma separated, e.g. cotton t-shirts, oversized">
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Meta Description</label>
                            <input type="text" name="blog_desc" class="form-control" required placeholder="A short snippet for SEO.">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Blog Content (HTML/Froala Editor)</label>
                            <textarea name="blog_content" id="blog_content_editor" class="form-control" rows="8"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Publish Date (Optional)</label>
                            <input type="datetime-local" name="blog_date" class="form-control">
                        </div>
                        <button type="submit" class="btn btn-premium btn-premium-primary w-100">Publish Blog Post</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="exampleModal003" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content w-50">
                <div class="modal-body d-flex flex-column align-items-center text-center">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Set the order Status</h1>
                    <form method="post" class="w-100">
                        {% csrf_token %}
                        <input type="hidden" name="o_id" class="form-control" required id="product_id_set_order">
                        <select class="form-select mt-2" name="o_status" aria-label="Default select example">
                            <option selected>Set the order Status</option>
                            <option value="Ordered">Ordered</option>
                            <option value="Shipped">Shipped</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Return in process">Return in process</option>
                            <option value="Return Accepted">Return Accepted</option>
                            <option value="Return Rejected">Return Rejected</option>
                            <option value="Return">Return</option>
                            <option value="Refund">Refund</option>
                        </select>
                        <button type="submit" class="btn btn-premium btn-premium-primary mt-3">Save
                            changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.2/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.print.min.js"></script>

    <script defer>
        // DataTable instance - completely disabled for cleaner premium Bootstrap table styling without scroll constraints
        /*
        var tableProducts = new DataTable('#example', {
            responsive: true,
            pageLength: 10,
            layout: {
                topStart: null
            }
        });

        var tableOrders = new DataTable('#order_session', {
            responsive: true,
            pageLength: 10,
            layout: {
                topStart: null
            }
        });
        */

        // Initialize popovers
        document.addEventListener('DOMContentLoaded', function () {
            // new DataTable('#reviews-session-tabel') // Disabled to avoid scrollbox and height constraints

            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
            popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl, {
                    container: 'body',
                    placement: 'right'
                });
            });

            document.addEventListener('click', function (e) {
                if (e.target.closest('[data-bs-toggle="popover"]') === null) {
                    var popovers = document.querySelectorAll('.popover');
                    popovers.forEach(function (popover) {
                        if (popover.style.display === 'block') {
                            bootstrap.Popover.getInstance(popover).hide();
                        }
                    });
                }
            });
        });

        // Open modal
        function set_order_st(pid) {
            var myModal = new bootstrap.Modal(document.getElementById('exampleModal003'));
            myModal.show();
            document.getElementById("product_id_set_order").value = pid;
        }
    </script>
    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/static/js/dashboard.js" defer></script>
    <script type='text/javascript'
        src='https://cdn.jsdelivr.net/npm/froala-editor@latest/js/froala_editor.pkgd.min.js'></script>



    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Custom Pro Dashboard Scripts -->
    <script>
        // Init editor on modal open/load
        document.addEventListener("DOMContentLoaded", function() {
            if (document.getElementById("blog_content_editor")) {
                new FroalaEditor("#blog_content_editor");
            }
            
            // Draw Chart.js Graph
            let ctx = document.getElementById('monthlySalesChart');
            if (ctx) {
                let salesData = {{ monthly_sales_json|safe }};
                let ordersData = {{ monthly_orders_json|safe }};
                
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                        datasets: [
                            {
                                label: 'Monthly Sales (₹)',
                                data: salesData,
                                backgroundColor: 'rgba(11, 46, 87, 0.85)',
                                borderColor: '#0b2e57',
                                borderWidth: 1,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Orders Count',
                                data: ordersData,
                                backgroundColor: 'rgba(230, 126, 34, 0.85)',
                                borderColor: '#d35400',
                                borderWidth: 1.5,
                                type: 'line',
                                tension: 0.3,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                labels: {
                                    font: { family: "'Outfit', sans-serif", size: 11 }
                                }
                            }
                        },
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: { display: true, text: 'Sales (₹)', font: { family: "'Outfit', sans-serif" } }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                grid: { drawOnChartArea: false },
                                title: { display: true, text: 'Orders', font: { family: "'Outfit', sans-serif" } }
                            }
                        }
                    }
                });
            }
            
            // Analytics Page - Sales Overview Chart
            let salesCtx = document.getElementById('analyticsSalesChart');
            if (salesCtx) {
                let salesData = {{ monthly_sales_json|safe }};
                new Chart(salesCtx, {
                    type: 'line',
                    data: {
                        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                        datasets: [{
                            label: 'Monthly Sales (₹)',
                            data: salesData,
                            backgroundColor: 'rgba(5, 32, 67, 0.1)',
                            borderColor: '#052043',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: { grid: { borderDash: [5, 5] } }
                        }
                    }
                });
            }

            // Analytics Page - Traffic Sources Chart (Doughnut)
            let trafficCtx = document.getElementById('analyticsTrafficChart');
            if (trafficCtx) {
                new Chart(trafficCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Direct', 'Organic Search', 'Social Media', 'Referrals'],
                        datasets: [{
                            data: [35, 40, 15, 10],
                            backgroundColor: ['#052043', '#fac13c', '#e63946', '#2ecc71'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }

            // Analytics Page - Customer Demographics Chart (Horizontal Bar)
            let demoCtx = document.getElementById('analyticsDemographicsChart');
            if (demoCtx) {
                new Chart(demoCtx, {
                    type: 'bar',
                    data: {
                        labels: ['18-24', '25-34', '35-44', '45+'],
                        datasets: [{
                            label: 'Percentage (%)',
                            data: [45, 35, 15, 5],
                            backgroundColor: '#052043',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
            
            // Initialize DataTables for custom tables - disabled for scrollbox-free, full height layouts
            /*
            $('.custom-datatable').each(function() {
                $(this).DataTable({
                    responsive: true,
                    pageLength: 10,
                    deferRender: true
                });
            });
            */
        });

        function searchDashboardTables() {
            let input = document.getElementById("dashboardSearchInput");
            let filter = input.value.toLowerCase();
            
            // Search inside all table rows of active section
            let rows = document.querySelectorAll(".content-section.active tbody tr");
            rows.forEach(row => {
                let text = row.innerText.toLowerCase();
                if (text.includes(filter)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
            
            // Search inside list items
            let items = document.querySelectorAll(".content-section.active .list-group-item");
            items.forEach(item => {
                let text = item.innerText.toLowerCase();
                if (text.includes(filter)) {
                    item.style.setProperty("display", "flex", "important");
                } else {
                    item.style.setProperty("display", "none", "important");
                }
            });
        }

        function copyTokenText(inputId) {
            var copyText = document.getElementById(inputId);
            copyText.select();
            copyText.setSelectionRange(0, 99999); // For mobile devices
            navigator.clipboard.writeText(copyText.value);
            swal({ text: "API Key copied to clipboard!", icon: "success", timer: 1500, buttons: false });
        }

        function submitApiKeyForm(form) {
            let csrf_token = document.querySelector("[name='csrfmiddlewaretoken']").value;
            let formData = new FormData(form);
            
            fetch("/usvesta-deshboard", {
                method: "POST",
                body: formData,
                headers: { "X-CSRFToken": csrf_token }
            })
            .then(res => res.json())
            .then(data => {
                swal({ text: data.res, icon: "success" }).then(() => window.location.reload());
            })
            .catch(err => console.error(err));
        }

        function deleteApiKey(keyId, btn) {
            if (!confirm("Are you sure you want to revoke this API Key? Third-party sites using it will lose access!")) return;
            let csrf_token = document.querySelector("[name='csrfmiddlewaretoken']").value;
            let formData = new FormData();
            formData.append("delete_api_key", keyId);
            
            fetch("/usvesta-deshboard", {
                method: "POST",
                body: formData,
                headers: { "X-CSRFToken": csrf_token }
            })
            .then(res => res.json())
            .then(data => {
                swal({ text: data.res, icon: "success" }).then(() => {
                    btn.closest("tr").remove();
                });
            });
        }

