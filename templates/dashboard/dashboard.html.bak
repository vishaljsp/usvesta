<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>US Vesta Admin Panel - E-commerce Store</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.2/css/buttons.dataTables.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/static/css/dashboard.css">
    <link href='https://cdn.jsdelivr.net/npm/froala-editor@latest/css/froala_editor.pkgd.min.css' rel='stylesheet'
        type='text/css' />
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
 


</head>

<body>

    <!-- Preloader -->
    <div id="preloader">
        <div class="spinner"></div>
    </div>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 sidebar">
                <div class="d-flex flex-column p-3">
                    <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none justify-content-center w-100 py-2">
                        <img src="/static/images/logo2.png" width="45" class="me-2 rounded-circle bg-white p-1">
                        <span class="fs-5 fw-bold text-uppercase tracking-wider" style="letter-spacing: 1px;">US VESTA</span>
                    </a>
                    <hr>
                    <ul class="nav nav-pills flex-column mb-auto">
                        <li class="nav-item">
                            <a href="#" class="nav-link active" data-section="dashboard">
                                <i class="fas fa-tachometer-alt"></i>
                                Dashboard
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="products">
                                <i class="fas fa-box"></i>
                                Products
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="categories">
                                <i class="fas fa-tags"></i>
                                Categories
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="subcategories">
                                <i class="fas fa-sitemap"></i>
                                Sub Categories
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="orders">
                                <i class="fas fa-shopping-cart"></i>
                                Orders
                            </a>
                        </li>
                        
                        <li>
                            <a href="#" class="nav-link" data-section="abandonedcheckouts">
                                <i class="fas fa-shopping-basket"></i>
                                Abandoned Checkouts
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="returns">
                                <i class="fas fa-undo-alt"></i>
                                Returns & Cancellations
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="Coordinatorsco">
                                <i class="fas fa-user-tie"></i>
                                Men's Coordinator
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="Reviews">
                                <i class="fas fa-star"></i>
                                User Reviews
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="banners">
                                <i class="fas fa-images"></i>
                                Carousel Banners
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="testimonials">
                                <i class="fas fa-comment-dots"></i>
                                Testimonials
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="trustedclients">
                                <i class="fas fa-handshake"></i>
                                Trusted Clients
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="instagram">
                                <i class="fab fa-instagram"></i>
                                Instagram Feed
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="aplus">
                                <i class="fas fa-star-of-life"></i>
                                A+ Listings
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="blogs">
                                <i class="fas fa-blog"></i>
                                Blogs Post & Cat
                            </a>
                        </li>
                        
                        <li>
                            <a href="#" class="nav-link" data-section="contacts">
                                <i class="fas fa-envelope-open-text"></i>
                                Contact Messages
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="apikeys">
                                <i class="fas fa-key"></i>
                                API Keys (Sync)
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link" data-section="analytics">
                                <i class="fas fa-chart-bar"></i>
                                Analytics
                            </a>
                        </li>
                        
                    </ul>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9 col-lg-10 main-content">
                <!-- Top Navbar -->
                <nav class="navbar navbar-expand navbar-light bg-white shadow-sm rounded-4 mb-4 px-4 py-2 d-flex justify-content-between align-items-center border border-1 border-light">
                    <!-- Search Bar -->
                    <div class="d-flex align-items-center" style="max-width: 360px; width: 100%;">
                        <div class="input-group">
                            <span class="input-group-text border-0"><i class="fas fa-search" style="color:#0b2e57;"></i></span>
                            <input type="text" class="form-control border-0" placeholder="Search sections / tables..." id="dashboardSearchInput" onkeyup="searchDashboardTables()">
                        </div>
                    </div>
                    
                    <!-- Mega Menu & Right Profile -->
                    <div class="d-flex align-items-center gap-3">
                        <div class="dropdown d-none d-md-block">
                            <button class="btn btn-light btn-sm dropdown-toggle border-0 bg-light fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Quick Menu
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/" target="_blank"><i class="fas fa-home me-2 text-warning"></i> Storefront Home</a></li>
                                <li><a class="dropdown-item" href="/shop" target="_blank"><i class="fas fa-shopping-bag me-2 text-warning"></i> Shop Catalog</a></li>
                                <li><a class="dropdown-item" href="/for-corporates" target="_blank"><i class="fas fa-building me-2 text-warning"></i> B2B Portal</a></li>
                            </ul>
                        </div>
                        
                        <!-- Notifications Dropdown -->
                        <div class="dropdown">
                            <div class="position-relative cursor-pointer text-muted px-2 dropdown-toggle border-0" data-bs-toggle="dropdown" aria-expanded="false" style="padding-right: 0 !important;">
                                <i class="fas fa-bell fs-5"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 8px;">
                                    3
                                </span>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2" style="width: 280px; border-radius: 12px; margin-top: 10px;">
                                <li class="dropdown-header fw-bold text-dark border-bottom pb-2 mb-2">Notifications</li>
                                <li>
                                    <a class="dropdown-item rounded-3 p-2 text-wrap mb-1" href="#" onclick="showNotificationDetails('New Order', 'Order #ORD-7842 has been placed successfully.')">
                                        <div class="fw-bold text-dark" style="font-size: 0.8rem;">New Order Received</div>
                                        <div class="text-muted small" style="font-size: 0.72rem;">Order #ORD-7842 placed by John.</div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3 p-2 text-wrap mb-1" href="#" onclick="showNotificationDetails('Return Request', 'Customer Emilee requested a return for Order #ORD-7839.')">
                                        <div class="fw-bold text-dark" style="font-size: 0.8rem;">Return Request</div>
                                        <div class="text-muted small" style="font-size: 0.72rem;">Order #ORD-7839 return requested.</div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3 p-2 text-wrap" href="#" onclick="showNotificationDetails('System Alert', 'New partner connected using API Key.')">
                                        <div class="fw-bold text-dark" style="font-size: 0.8rem;">API Integration Sync</div>
                                        <div class="text-muted small" style="font-size: 0.72rem;">Product catalog sync request logged.</div>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        
                        <!-- User Profile Info -->
                        <div class="d-flex align-items-center gap-2 border-start ps-3">
                            {% if request.user.profile_image %}
                            <img src="{{ request.user.profile_image.url }}" width="36" height="36" class="rounded-circle border">
                            {% else %}
                            <img src="/static/images/user_profile.webp" width="36" height="36" class="rounded-circle border">
                            {% endif %}
                            <div class="d-none d-lg-block">
                                <div class="fw-bold text-dark" style="font-size: 0.85rem; line-height: 1.2;">{{ request.user.first_name }} {{ request.user.last_name }}</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Administrator</div>
                            </div>
                        </div>
                    </div>
                </nav>

                <!-- Dashboard Section -->
                <div class="content-section active" id="dashboard-section">
                    <div class="row g-4">
                        <!-- 🎯 Welcome Card -->
                        <div class="col-lg-4">
                            <div class="welcome-card">
                                <div>
                                    <h4>Welcome Back! 👋</h4>
                                    <p>US Vesta Commerce System</p>
                                </div>
                                <div class="welcome-user">
                                    {% if request.user.profile_image %}
                                    <img src="{{ request.user.profile_image.url }}">
                                    {% else %}
                                    <img src="/static/images/user_profile.webp">
                                    {% endif %}
                                    <div>
                                        <h5>{{ request.user.first_name }}</h5>
                                        <span class="badge">Admin / Owner</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- 🎯 Premium Metric Cards -->
                        <div class="col-lg-8">
                            <div class="row g-3">
                                <div class="col-md-6 col-xl-3">
                                    <div class="stat-card">
                                        <div>
                                            <div class="stat-label">Orders</div>
                                            <div class="stat-value" data-target="{{ total_orders }}">{{ total_orders }}</div>
                                            <div class="stat-change text-success"><i class="fas fa-arrow-up"></i> Live</div>
                                        </div>
                                        <div class="stat-icon" style="background:rgba(16,185,129,0.1);color:#10b981;"><i class="fas fa-shopping-cart"></i></div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-xl-3">
                                    <div class="stat-card">
                                        <div>
                                            <div class="stat-label">Revenue</div>
                                            <div class="stat-value" data-target="{{ total_revenue|floatformat:0 }}">₹{{ total_revenue|floatformat:0 }}</div>
                                            <div class="stat-change text-success"><i class="fas fa-arrow-up"></i> Total</div>
                                        </div>
                                        <div class="stat-icon" style="background:rgba(250,193,60,0.1);color:#fac13c;"><i class="fas fa-wallet"></i></div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-xl-3">
                                    <div class="stat-card">
                                        <div>
                                            <div class="stat-label">Avg Price</div>
                                            <div class="stat-value" data-target="{{ avg_price|floatformat:0 }}">₹{{ avg_price|floatformat:0 }}</div>
                                            <div class="stat-change text-info"><i class="fas fa-chart-line"></i> Market</div>
                                        </div>
                                        <div class="stat-icon" style="background:rgba(59,130,246,0.1);color:#3b82f6;"><i class="fas fa-tag"></i></div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-xl-3">
                                    <div class="stat-card">
                                        <div>
                                            <div class="stat-label">Customers</div>
                                            <div class="stat-value" data-target="{{ total_customers }}">{{ total_customers }}</div>
                                            <div class="stat-change text-warning"><i class="fas fa-users"></i> Registered</div>
                                        </div>
                                        <div class="stat-icon" style="background:rgba(245,158,11,0.1);color:#f59e0b;"><i class="fas fa-users"></i></div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Monthly Sales Chart Card -->
                            <div class="card mt-3 border-0 shadow-sm bg-white">
                                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold mb-0" style="color: #0b2e57;">Monthly Sales Analysis</h6>
                                    <span class="badge bg-light text-dark fw-bold" style="font-size: 0.7rem;">Real-time Metrics</span>
                                </div>
                                <div class="card-body">
                                    <canvas id="monthlySalesChart" style="max-height: 180px;"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-sm bg-white h-100">
                                <div class="card-header bg-transparent border-0 py-3">
                                    <h6 class="fw-bold mb-0" style="color: #0b2e57;">Recent Orders</h6>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0 align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Order ID</th>
                                                    <th>Customer</th>
                                                    <th>Date</th>
                                                    <th>Amount</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for order in all_orders|slice:":5" %}
                                                <tr>
                                                    <td><strong>{{ order.order_id }}</strong></td>
                                                    <td>{{ order.custom_name|default:order.user.username }}</td>
                                                    <td>{{ order.created_at|date:"d M Y" }}</td>
                                                    <td>₹{{ order.total_price }}</td>
                                                    <td>
                                                        {% if order.status == "Delivered" %}
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Delivered</span>
                                                        {% elif order.status == "Pending" or order.status == "Ordered" %}
                                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 rounded-pill">Pending</span>
                                                        {% else %}
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">{{ order.status }}</span>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                                {% empty %}
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted py-4">No recent orders yet.</td>
                                                </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm bg-white h-100">
                                <div class="card-header bg-transparent border-0 py-3">
                                    <h6 class="fw-bold mb-0" style="color: #0b2e57;">Top Catalog Products</h6>
                                </div>
                                <div class="card-body p-0">
                                    <ul class="list-group list-group-flush">
                                        {% for p in products_all|slice:":5" %}
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-4 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                {% if p.product_image %}
                                                <img src="{{ p.product_image.url }}" width="40" height="40" class="rounded-3 border" style="object-fit: cover;">
                                                {% else %}
                                                <img src="/static/product_select_img.png" width="40" height="40" class="rounded-3 border" style="object-fit: cover;">
                                                {% endif %}
                                                <div>
                                                    <div class="fw-semibold text-dark" style="font-size: 0.85rem; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ p.product_name }}</div>
                                                    <div class="text-muted small" style="font-size: 0.75rem;">₹{{ p.b2c_price }}</div>
                                                </div>
                                            </div>
                                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3" style="font-size: 0.75rem;">{{ p.total_sale_products|default:"0" }} sales</span>
                                        </li>
                                        {% empty %}
                                        <li class="list-group-item text-center text-muted py-4">No products in catalog.</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Products Section -->
                <div class="content-section" id="products-section">
                    <div class="page-header">
                        <h1>Products Management</h1>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-premium btn-premium-primary" onclick="add_product_form_in_bulk()">
                                <i class="fas fa-upload"></i> Bulk Upload
                            </button>
                            <button class="btn btn-premium btn-premium-gold" onclick="add_product_form()">
                                <i class="fas fa-plus"></i> Add Product
                            </button>
                            <button class="btn btn-premium btn-premium-outline" onclick="show_product_list_form()">
                                <i class="fa-solid fa-eye"></i> All Products
                            </button>
                        </div>
                    </div>
                    <div id="all_products_list">
                    <div class="row">
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span><i class="fas fa-box me-2"></i>All Products List</span>
                                <div class="d-flex gap-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="checkAllProducts" onchange="toggleCheckAll('product', this)">
                                        <label class="form-check-label fw-semibold" for="checkAllProducts" style="font-size:0.85rem;">Select All</label>
                                    </div>
                                    <button class="btn btn-danger btn-sm" id="bulkDeleteProductsBtn" onclick="bulkDeleteProducts()" style="display:none;">
                                        <i class="fas fa-trash-alt me-1"></i> Delete Selected (<span id="selectedProductsCount">0</span>)
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table id="example" class="table table-hover align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width: 40px;"><input type="checkbox" id="checkAllProductsHead" onchange="toggleCheckAll('product', this)" style="width: 16px; height: 16px;"></th>
                                                <th>Product</th>
                                                <th>Type / Price</th>
                                                <th>Status</th>
                                                <th style="width:140px;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for a in products_all %}
                                            {% for b in a.color_product_set.all %}
                                            <tr class="product-row" data-product-type="inner" data-product-id="{{ b.id }}">
                                                <td><input type="checkbox" class="product-checkbox" onchange="updateBulkDeleteBtn('product')" style="width: 16px; height: 16px;"></td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="product-img-wrapper">
                                                            <img loading="lazy" src="{% if b.color_images %}{{ b.color_images.url }}{% else %}/static/product_select_img.png{% endif %}" class="rounded-3 border">
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold text-dark text-wrap" style="max-width: 350px;">{{ a.product_name }}</div>
                                                            <span class="badge bg-secondary-subtle text-secondary small mt-1">Color: {{ b.color }} | ID: {{ b.id }}</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-info-subtle text-info px-3 py-2 rounded-pill">Variant</span>
                                                    <div class="text-muted small mt-1">₹{{ a.b2c_price }}</div>
                                                </td>
                                                <td>
                                                    {% if a.product_status == "Publish" %}
                                                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill"><i class="fas fa-circle me-1" style="font-size:6px;"></i> Published</span>
                                                    {% else %}
                                                    <span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill"><i class="fas fa-circle me-1" style="font-size:6px;"></i> Draft</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    <div class="d-flex gap-1">
                                                        <a href="/products/{{ a.uuid_product }}" target="_blank" class="btn btn-action-view" title="View"><i class="fas fa-eye"></i></a>
                                                        <a href="/usvesta-deshboard/update-product/{{b.uuid_product}}?product-type=inner-product" class="btn btn-action-edit" title="Edit"><i class="fas fa-pencil-alt"></i></a>
                                                        <button type="button" class="btn btn-action-delete" onclick="Iner_product_delete({{b.id}}, this)" title="Delete"><i class="fas fa-trash"></i></button>
                                                    </div>
                                                </td>
                                            </tr>
                                            {% endfor %}
                                            <tr class="product-row" data-product-type="root" data-product-id="{{ a.id }}">
                                                <td><input type="checkbox" class="product-checkbox" onchange="updateBulkDeleteBtn('product')" style="width: 16px; height: 16px;"></td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="product-img-wrapper">
                                                            {% if a.product_image %}
                                                            <img src="{{ a.product_image.url }}" class="rounded-3 border">
                                                            {% else %}
                                                            <img src="/static/product_select_img.png" class="rounded-3 border">
                                                            {% endif %}
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold text-dark text-wrap" style="max-width: 350px;">{{ a.product_name }}</div>
                                                            <span class="badge bg-primary-subtle text-primary small mt-1">B2C: ₹{{ a.b2c_price }} | B2B: ₹{{ a.b2b_price }}</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">Root</span>
                                                    <div class="text-muted small mt-1">SKU: {{ a.product_sku|default:"N/A" }}</div>
                                                </td>
                                                <td>
                                                    {% if a.product_status == "Publish" %}
                                                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill"><i class="fas fa-circle me-1" style="font-size:6px;"></i> Published</span>
                                                    {% else %}
                                                    <span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill"><i class="fas fa-circle me-1" style="font-size:6px;"></i> Draft</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    <div class="d-flex gap-1">
                                                        <a href="/products/{{ a.uuid_product }}" target="_blank" class="btn btn-action-view" title="View"><i class="fas fa-eye"></i></a>
                                                        <a href="/usvesta-deshboard/update-product/{{a.uuid_product}}?product-type=product" class="btn btn-action-edit" title="Edit"><i class="fas fa-pencil-alt"></i></a>
                                                        <button type="button" class="btn btn-action-delete" onclick="product_delete({{a.id}},this)" title="Delete"><i class="fas fa-trash"></i></button>
                                                    </div>
                                                </td>
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    </div>

                    <form action="" id="bulk_product_add_form" method="post" enctype="multipart/form-data">
                        {% csrf_token %}
                        <div class="card">
                            <div class="card-header">
                                Add Products in bulk
                            </div>
                            <div class="card-body">

                                <div class="mb-3">
                                    <label for="productName" class="form-label">Upload XL File</label>
                                    <input type="file" class="form-control" name="xl_file_name_for_bluk_upload" id="xl_file_name_for_bluk_upload" required>
                                </div>
                                <button type="submit" class="btn btn-premium btn-premium-primary w-100 mb-2" id="bulk_submit_btn">
                                    <span id="bulk_btn_text">
                                        <i class="fas fa-save me-1"></i> Upload File
                                    </span>

                                    <!-- Hidden Spinner -->
                                    <span id="bulk_btn_spinner" class="spinner-border spinner-border-sm" style="display:none;"></span>
                                </button>

                             
                            </div>
                        </div>
                    </form>
                    
                    <!-- ✅ PROGRESS BAR -->
                    <div id="uploadProgressBox" style="display:none; margin-top:15px;">
                        <div style="width:100%; background:#e0e0e0; border-radius:5px;">
                            <div id="uploadProgressBar"
                                style="width:0%; height:20px; background:#4caf50; border-radius:5px;">
                            </div>
                        </div>
                        <p id="uploadProgressText" style="margin-top:8px;">
                            Uploading products, please wait...
                        </p>
                    </div>

                    <form id="productForm" method="post" enctype="multipart/form-data" >
                        {% csrf_token %}

                        <div class="row">
                            <div class="col-lg-8">
                                <!-- Basic Information Card -->
                                <div class="card">
                                    <div class="card-header">
                                        Basic Information
                                    </div>
                                    <div class="card-body">

                                        <div class="mb-3">
                                            <label for="productName" class="form-label">Product Name</label>
                                            <input type="text" class="form-control" id="productName"
                                                placeholder="Enter product name" required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="productDescription" class="form-label">Description</label>
                                            <textarea class="form-control" id="productDescription" rows="5"
                                                placeholder="Enter product description"></textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label for="productDescription" class="form-label"> Highlight</label>
                                            <textarea class="form-control" id="productHighlight" rows="5"
                                                placeholder="Enter product Highlight"></textarea>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productCategory" class="form-label">Sub Category</label>
                                                    <select class="form-select" id="productCategory" required>
                                                        <option value="" selected disabled>Select Sub category</option>
                                                        {% for a in sub_cat %}
                                                        <option value="{{a.id}}">{{a.name}}</option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productBrand" class="form-label">Brand</label>
                                                    <input type="text" class="form-control" id="productBrand"
                                                        placeholder="Enter brand name">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productBrand" class="form-label"> Ratings </label>
                                                    <input type="text" class="form-control" id="productratings"
                                                        placeholder="Enter Ratings">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productBrand" class="form-label">Total Sale
                                                        Products</label>
                                                    <input type="text" class="form-control" id="total_sale_product"
                                                        placeholder="Enter Total Sale Products">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productCategory" class="form-label"> T shirt type
                                                    </label>
                                                    <select class="form-select" id="t-shirt-type" required>
                                                        <option value="" selected disabled>Select T shirt type </option>
                                                        <option value="Collar Neck T Shirt">Collar Neck T Shirt</option>
                                                        <option value="Round Neck T Shirt">Round Neck T Shirt</option>

                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productBrand" class="form-label">Key Words</label>
                                                    <input type="text" class="form-control" id="key_word"
                                                        placeholder="Enter Key Words">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productBrand" class="form-label">Offer Product Quantity</label>
                                                    <input type="text" name="offer_p_qty" class="form-control" id="product_quantity_offer"
                                                        placeholder="Enter Offer Product Quantity">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productBrand" class="form-label">Offer Product Amount</label>
                                                    <input type="text"  name="offer_p_amount" class="form-control" id="product_amount_offer"
                                                        placeholder="Offer Product Amount">
                                                </div>
                                            </div>
                                        </div>


                                    </div>
                                </div>

                                <!-- Pricing & Inventory Card -->
                                <div class="card">
                                    <div class="card-header">
                                        Pricing & Inventory
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productPrice" class="form-label">Sale Price</label>
                                                    <div class="price-input-group">
                                                        <span>₹</span>
                                                        <input type="number" class="form-control" id="sale-Price"
                                                            placeholder="0.00" step="0.01" min="0" required>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productComparePrice" class="form-label">Regular
                                                        price</label>
                                                    <div class="price-input-group">
                                                        <span>₹</span>
                                                        <input type="number" class="form-control" id="regularPrice"
                                                            placeholder="0.00" step="0.01" min="0">
                                                    </div>
                                                    <div class="form-text"></div>
                                                </div>
                                            </div>
                                        </div>

                                        
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productQuantity" class="form-label">Color</label>
                                                    <input type="text" class="form-control" id="product-color"
                                                        placeholder="0" min="0" required>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productBarcode" class="form-label">Color Code</label>
                                                    <input type="text" class="form-control" id="product-color-code">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productQuantity" class="form-label">Product
                                                        Image</label>
                                                    <input type="file" class="form-control" id="product_image" required>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="productBarcode" class="form-label">Image ALT
                                                        Name</label>
                                                    <input type="text" class="form-control" id="imagealtname">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Product Images Card -->
                                <div class="card">
                                    <div class="card-header">
                                        Product Gallery Images
                                    </div>
                                    <div class="card-body">
                                        <div class="image-preview-container" id="imagePreviewContainer">
                                            <!-- Image previews will be added here -->
                                        </div>
                                        <div class="image-upload-area" id="imageUploadArea">
                                            <i class="fas fa-cloud-upload-alt"></i>
                                            <h5>Drag & Drop images here</h5>
                                            <p class="text-muted">or</p>
                                            <button type="button" class="btn btn-premium btn-premium-primary" id="uploadImageBtn">
                                                <i class="fas fa-folder-open me-1"></i> Browse Files
                                            </button>
                                            <input type="file" id="imageInput" multiple accept="image/*"
                                                style="display: none;">
                                        </div>
                                    </div>
                                </div>
                                <!-- Color Variants Card -->
                                <div class="card">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <span>Color Variants</span>
                                        <button type="button" class="btn btn-sm btn-premium btn-premium-gold" id="addColorVariant">
                                            <i class="fas fa-plus me-1"></i> Add Color
                                        </button>
                                    </div>
                                    <div class="card-body">
                                        <div class="color-variants-container" id="colorVariantsContainer">
                                            <!-- Color variants will be added here dynamically -->
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <!-- Status Card -->
                                <div class="card">
                                    <div class="card-header">
                                        Status
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label class="form-label">Product Status</label>
                                            <div class="d-flex align-items-center">
                                                <label class="toggle-switch me-3">
                                                    <input type="checkbox" id="productStatus" checked>
                                                    <span class="toggle-slider"></span>
                                                </label>
                                                <span id="statusText" class="status-badge status-active">Active</span>
                                            </div>
                                            <div class="form-text">Only active products are visible to customers.</div>
                                        </div>


                                        <div class="mb-3">
                                            <label class="form-label"> Top 8 products </label>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="onlineStore">
                                                <label class="form-check-label" for="onlineStore">
                                                    Only active products are visible At Home.
                                                </label>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Size</label>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" value="XXL"
                                                    id="onlineStore" checked>
                                                <label class="form-check-label" for="onlineStore">
                                                    XXL
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" value="XL"
                                                    id="onlineStore" checked>
                                                <label class="form-check-label" for="onlineStore">
                                                    XL
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" value="L" type="checkbox" id="pos">
                                                <label class="form-check-label" for="pos">
                                                    L
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" value="M" type="checkbox" id="facebook">
                                                <label class="form-check-label" for="facebook">
                                                    M
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" value="S" type="checkbox"
                                                    id="instagram">
                                                <label class="form-check-label" for="instagram">
                                                    S
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <!-- Save Actions -->
                                <div class="card">
                                    <div class="card-body">
                                        <button type="submit" class="btn btn-premium btn-premium-primary w-100 mb-2" id="form_add_product_btn">
                                            <i class="fas fa-save me-1"></i> Save Product 
                                            
                                        </button>
                                        <button class="btn btn-premium btn-premium-primary w-100 mb-2" type="button" disabled id="form_add_product_btn_spin">
                                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                            Loading...
                                        </button>
                                        <button type="button" class="btn btn-premium btn-premium-outline w-100">
                                            <i class="fas fa-times me-1"></i> Cancel
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Categories Section -->
                <div class="content-section" id="categories-section">
                    <div class="page-header">
                        <h1>Categories</h1>
                        <button class="btn btn-premium btn-premium-gold" data-bs-toggle="modal" data-bs-target="#addnewcategory">
                            <i class="fas fa-plus"></i> Add Category
                        </button>
                    </div>

                    <div class="row">
                        {% for a in category %}
                        <div class="col-md-4">
                            <div class="card category-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <img src="{% if a.category_image %} {{a.category_image.url}} {% endif %}" alt="{{a.name}}" class="rounded-circle"
                                            loading="lazy" width="100" height="100">
                                        <h5 class="card-title">{{a.name}}</h5>
                                    </div>
                                    <div class="d-flex my-2">
                                        <button class="btn btn-sm btn-premium btn-premium-primary me-2"
                                            onclick="open_categoryedit_model({{a.id}},`{{a.name}}`)">Edit</button>
                                        <button class="btn btn-sm btn-premium btn-premium-outline"
                                            onclick="Category_delete({{a.id}})">Delete</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}

                    </div>
                </div>

                 <!-- Sub Categories Section -->
                <div class="content-section" id="subcategories-section">
                    <div class="page-header">
                        <h1>Categories</h1>
                        <button class="btn btn-premium btn-premium-gold" data-bs-toggle="modal" data-bs-target="#addnewsubcategory">
                            <i class="fas fa-plus"></i> Add Sub Category
                        </button>
                    </div>

                    <div class="row">
                        {% for a in sub_cat %}
                            <div class="col-md-4">
                                <div class="card category-card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            {% if a.category_image %}
                                                <img loading="lazy" src="{{a.category_image.url}}" alt="{{a.name}}" class="rounded-circle" width="100" height="100">
                                            {% endif %}
                                            <h5 class="card-title">{{a.name}}</h5>
                                        </div>
                                        <div class="d-flex my-2">
                                            <button class="btn btn-sm btn-premium btn-premium-primary me-2"
                                                onclick="open_sub_categoryedit_model({{a.id}},`{{a.name}}`)">Edit</button>
                                            <button class="btn btn-sm btn-premium btn-premium-outline"
                                                onclick="SubCategory_delete({{a.id}})">Delete</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}

                    </div>
                </div>

                <!-- Orders Section -->
                <div class="content-section" id="orders-section">
                    <div class="page-header">
                        <h1>Orders Management</h1>
                    </div>

                    <!-- Status sub-tabs filter -->
                    <ul class="nav nav-tabs mb-4" id="orderStatusTabs" role="tablist" style="border-bottom: 2px solid #f1f3f5;">
                        <li class="nav-item">
                            <a class="nav-link active text-dark fw-bold" href="#" onclick="filterOrdersByStatus('all', this)">All Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-muted" href="#" onclick="filterOrdersByStatus('ordered', this)">In Progress</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-muted" href="#" onclick="filterOrdersByStatus('delivered', this)">Delivered</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-muted" href="#" onclick="filterOrdersByStatus('cancelled', this)">Cancelled</a>
                        </li>
                    </ul>

                    <div class="card border-0 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2 bg-transparent border-bottom">
                            <span class="fw-bold" style="color:#0b2e57;"><i class="fas fa-shopping-cart me-2"></i>All Orders</span>
                            <div class="d-flex gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="checkAllOrders" onchange="toggleCheckAll('order', this)">
                                    <label class="form-check-label fw-semibold" for="checkAllOrders" style="font-size:0.85rem;">Select All</label>
                                </div>
                                <button class="btn btn-danger btn-sm" id="bulkDeleteOrdersBtn" onclick="bulkDeleteOrders()" style="display:none;">
                                    <i class="fas fa-trash-alt me-1"></i> Delete Selected (<span id="selectedOrdersCount">0</span>)
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table id="order_session" class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width: 40px;"><input type="checkbox" id="checkAllOrdersHead" onchange="toggleCheckAll('order', this)" style="width: 16px; height: 16px;"></th>
                                            <th>Product</th>
                                            <th>Delivery Time</th>
                                            <th>Pym Type</th>
                                            <th>Amount</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for a in all_orders %}
                                        <tr data-status="{{ a.status }}" id="order-row-{{ a.id }}" class="order-row" data-order-id="{{ a.id }}">
                                            <td><input type="checkbox" class="order-checkbox" onchange="updateBulkDeleteBtn('order')" style="width: 16px; height: 16px;"></td>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    {% if a.custom_design %}
                                                    <a href="{{a.custom_design.url}}" target="_blank" class="btn btn-action-view btn-xs me-2" title="View PDF">
                                                        <i class="fa-solid fa-file-pdf"></i>
                                                    </a>
                                                    {% endif %}
                                                    <div class="order-img-wrapper">
                                                        <img loading="lazy" src="{% if a.product.product_image %}{{ a.product.product_image.url }}{% else %}{{ a.inner_color_product.color_images.url }}{% endif %}" alt="Product">
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark text-wrap" style="max-width: 250px;">
                                                            {% if a.product.product_name %}{{ a.product.product_name }}{% else %}{{ a.inner_color_product.product.product_name }}{% endif %}
                                                        </div>
                                                        <div class="text-muted small">Qty: {{ a.quantity }} | Size: {{ a.product_size }} | <span class="text-primary fw-semibold">{{ a.custom_name|default:a.user.username }}</span></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>{{ a.created_at|date:"d M Y, h:i A" }}</td>
                                            <td><span class="badge bg-light text-dark px-3 py-1 rounded-pill">{{ a.payment_method }}</span></td>
                                            <td class="fw-bold">₹{{ a.total_price }}</td>
                                            <td>
                                                {% if a.status == "Delivered" %}
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Delivered</span>
                                                {% elif a.status == "Pending" or a.status == "Ordered" or a.status == "Ordered" %}
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 rounded-pill">Pending</span>
                                                {% else %}
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">{{ a.status }}</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-action-view me-1" onclick="view_order_details_in_dashboard({{ a.id }})" title="View Details"><i class="fas fa-eye"></i></button>
                                                    <button class="btn btn-action-edit me-1" onclick="set_order_st({{ a.id }})" title="Edit Status"><i class="fas fa-pencil-alt"></i></button>
                                                    <button class="btn btn-action-delete" onclick="deleteOrder({{ a.id }}, this)" title="Delete Order"><i class="fas fa-trash"></i></button>
                                                </div>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>


                <!--  Men's T-shirts Coordinator -->
                <div class="content-section" id="Coordinatorsco-section">   
                    <div class="page-header">
                        <h1>Men's T-shirts Coordinator</h1>
                        <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-premium btn-premium-gold" onclick="Coordinator_add_form()">
                            <i class="fas fa-plus"></i> Add Customer
                        </button>
                         <button class="btn btn-premium btn-premium-outline" onclick="Coordinator_show_list()">
                                <i class="fa-solid fa-eye"></i> All Coordinator
                        </button>
                        </div>
                    </div>

                    <div class="card">
                        <!-- add coodinator  form -->
                        <div id="adding_coodinator_form">
                            <div class="d-flex justify-content-center align-items-center vh-100 bg-light">
                                <div class="card shadow-lg p-4 rounded-4" style="width: 100%; max-width:95%">
                                    <h2 class="text-center mb-4 text-primary">Add Coordinator</h2>
                                    
                                    <form action="/usvesta-deshboard-sending_databdbjajnsjansJnj" method="post">
                                    {% csrf_token %}
                                    <div class="mb-3">
                                        <label for="coordinator_name" class="form-label fw-semibold">Categories</label>

                                        <select class="form-select" name="coordinator_sub_category" aria-label="Default select example">
                                            <option selected>Select Sub Categories</option>
                                            {% for a in sub_cat %}
                                                <option value="{{a.id}}">{{a.name}}</option>
                                            {% endfor %}
                                            
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label for="coordinator_name" class="form-label fw-semibold">Coordinator Name</label>
                                        <input type="text" class="form-control" name="coordinator_name" placeholder="Enter Coordinator Name" required>
                                    </div>

                                    <div class="mb-3">
                                        <label for="coordinator_content" class="form-label fw-semibold">Content</label>
                                        <textarea style="height: 350px; overflow-y:auto" id="codinator_frola" class="form-control" name="coordinator_content" placeholder="Coordinator Content" rows="4" required></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Select Pages</label>

                                        <select class="form-select" name="show_on_pages" multiple required>
                                            <option value="/">Home Page</option>
                                            <option value="/our-story">Our Story Page</option>
                                            <option value="/shop">Shop Page</option>
                                            <option value="/contact-us">Contact US</option>
                                            <option value="/for-corporates">For Corporates Page B2B</option>
                                            <option value="/blog">Blogs</option>
                                        </select>

                                        <small class="text-muted">Hold Ctrl (Windows) / Cmd (Mac) to select multiple</small>
                                    </div>

                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-premium btn-premium-primary btn-lg shadow-sm">
                                        Submit
                                        </button>
                                    </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                         <!-- update coodinator  form -->
                        <div id="update_coodinator_form">
                            <div class="d-flex justify-content-center align-items-center vh-100 bg-light">
                                <div class="card shadow-lg p-4 rounded-4" style="width: 100%; max-width:95%;">
                                    <h2 class="text-center mb-4 text-primary">Update Coordinator</h2>
                                    
                                    <form action="/usvesta-deshboard-sending_databdbjajnsjansJnj" method="post">
                                    {% csrf_token %}
                                    <div class="mb-3">
                                        <select class="form-select"  name="coordinator_sub_category_update" aria-label="Default select example">
                                            <option id="coordinator_sub_category_update" >Select Sub Categories</option>
                                            {% for a in sub_cat %}
                                                <option value="{{a.id}}">{{a.name}}</option>
                                            {% endfor %}
                                            
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label for="coordinator_name" class="form-label fw-semibold">Coordinator Name</label>
                                        <input type="text"  class="form-control" id="coordinator_name_update" name="coordinator_name_update" placeholder="Enter Coordinator Name" required>
                                        <input type="text" id="coordinator_update_id" hidden class="form-control" name="coordinator_update_id"  required>
                                    </div>

                                    <div class="mb-3">
                                        <label for="coordinator_content" class="form-label fw-semibold">Content</label>
                                        <textarea class="form-control"  id="coordinator_content_update" name="coordinator_content_update" placeholder="Coordinator Content" rows="4" required></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Select Pages</label>

                                        <select class="form-select" name="show_on_pages_update" multiple>
                                            <option value="/" {% if "/" in coordinator.show_on_pages %}selected{% endif %}>Home Page</option>
                                            <option value="/our-story" {% if "/our-story" in coordinator.show_on_pages %}selected{% endif %}>Our Story Page</option>
                                            <option value="/shop" {% if "/shop" in coordinator.show_on_pages %}selected{% endif %}>Shop Page</option>
                                            <option value="/contact-us" {% if "/contact-us" in coordinator.show_on_pages %}selected{% endif %}>Contact US</option>
                                            <option value="/for-corporates" {% if "/for-corporates" in coordinator.show_on_pages %}selected{% endif %}>For Corporates Page B2B</option>
                                            <option value="/blog" {% if "/blog" in coordinator.show_on_pages %}selected{% endif %}>Blogs</option>
                                        </select>
                                    </div>

                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-premium btn-premium-primary btn-lg shadow-sm">
                                        Submit
                                        </button>
                                    </div>
                                    </form>
                                </div>
                            </div>
                        </div>



                        <div class="card-body" id="coodinator_list">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Categories</th>
                                            <th> Content </th>
                                            
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for a in coordinator %}
                                        <tr>
                                            
                                            <td>{{a.name|truncatechars:30}}</td>
                                            <td>{{a.sub_category.name}}</td>
                                            <td id="codinator_cnt">{{a.containt|safe|truncatechars_html:70}}</td>
                                           
                                            <td>
                                                <button class="btn btn-sm btn-premium btn-premium-primary" onclick="Coordinator_edit_form(`{{a.name}}`,`{{a.sub_category.name}}`,{{a.sub_category.id}},`{{a.containt}}`,{{a.id}})"><i class="fa-solid fa-pen-to-square"></i>Edit</button>
                                                <button class="btn btn-sm btn-premium btn-premium-outline" onclick="Coordinator_delete({{a.id}},this)"><i class="fa-solid fa-trash"></i>Delete</button>

                                            </td>
                                           
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- rewive Section -->
                <!-- Review Section -->
                <div class="content-section" id="Reviews-section">
                    <div class="page-header">
                        <h1>User Reviews</h1>
                        <div>
                       {% csrf_token %}

                        <button id="generateReviewsBtn" class="btn btn-premium btn-premium-gold">
                            <i class="fas fa-robot me-1"></i> Generate Fake Reviews (5 per product)
                        </button>

                        <button class="btn btn-premium btn-premium-gold" onclick="review_add_form()">
                            <i class="fas fa-plus"></i> Add Review
                        </button>
                        <button class="btn btn-premium btn-premium-outline" onclick="review_show_list()">
                                <i class="fa-solid fa-eye"></i> All Reviews
                        </button>
                    </div>

                    </div>

                    <div class="card">
                        <div class="card-body">
                            <div id="reviewProgressBox" style="display:none; margin-top:15px;">
                                <div style="width:100%; background:#e0e0e0; border-radius:5px;">
                                    <div id="reviewProgressBar"
                                        style="width:0%; height:20px; background:#2196f3; border-radius:5px; transition:width 0.4s;">
                                    </div>
                                </div>
                                <p id="reviewProgressText" style="margin-top:8px;">
                                    Generating reviews, please wait...
                                </p>
                            </div>

                            <!-- add coodinator  form -->
                            <div id="adding_reviews_form"> 
                                <div class="d-flex justify-content-center align-items-center vh-100 bg-light">
                                    <div class="card shadow-lg p-4 rounded-4" style="width: 100%; max-width: 800px;">
                                        <h2 class="text-center mb-4 text-primary">Add Review</h2>
                                        
                                        <form action="/usvesta-deshboard-sending_databdbjajnsjansJnj" method="post">
                                            {% csrf_token %}
                                            
                                            <div class="mb-3">
                                                <label for="review_name" class="form-label fw-semibold">Name</label>
                                                <input type="text" class="form-control" id="review_name" name="review_name" placeholder="Enter Name" required>
                                            </div>

                                            <div class="mb-3">
                                                <label for="review_email" class="form-label fw-semibold">Email</label>
                                                <input type="email" class="form-control" id="review_email" name="review_email" placeholder="Enter Email" required>
                                            </div>
                                            <div class="mb-3">
                                                <select class="form-select form-select-sm" name="product_id_for_Rewive" aria-label=".form-select-sm example">
                                                    <option selected>Select Product</option>
                                                    
                                                    {% for a in products_all %}
                                                    <option value="{{a.id}}">{{a.product_name}}</option>
                                                    {% endfor %}

                                                    {% for a in color_productskkx %}
                                                    <option value="{{a.id}}">{{a.product.product_name}}</option>
                                                    {% endfor %}
                                                
                                                </select>
                                            </div>

                                            <div class="mb-3 form-check">
                                                <input type="checkbox" class="form-check-input" id="reviews_showhide" name="reviews_showhide">
                                                <label class="form-check-label fw-semibold" for="reviews_showhide">Show / Hide</label>
                                            </div>

                                            <!-- ⭐ Star Rating Section -->
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold d-block">Rating</label>
                                                <div class="star-rating">
                                                    <input type="radio" id="star5" name="rating" value="5" required>
                                                    <label for="star5" title="5 stars">&#9733;</label>

                                                    <input type="radio" id="star4" name="rating" value="4">
                                                    <label for="star4" title="4 stars">&#9733;</label>

                                                    <input type="radio" id="star3" name="rating" value="3">
                                                    <label for="star3" title="3 stars">&#9733;</label>

                                                    <input type="radio" id="star2" name="rating" value="2">
                                                    <label for="star2" title="2 stars">&#9733;</label>

                                                    <input type="radio" id="star1" name="rating" value="1">
                                                    <label for="star1" title="1 star">&#9733;</label>
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label for="reviews_meseje" class="form-label fw-semibold">Message</label>
                                                <textarea class="form-control" id="reviews_meseje" name="reviews_meseje" placeholder="Message" rows="4" required></textarea>
                                            </div>

                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-premium btn-premium-primary btn-lg shadow-sm">Submit</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <div id="update_reviews_form"> 
                                <div class="d-flex justify-content-center align-items-center vh-100 bg-light">
                                    <div class="card shadow-lg p-4 rounded-4" style="width: 100%; max-width: 800px;">
                                        <h2 class="text-center mb-4 text-primary">Update Review</h2>
                                        
                                        <form action="/usvesta-deshboard-sending_databdbjajnsjansJnj" method="post">
                                            {% csrf_token %}
                                            
                                            <div class="mb-3">
                                                <label for="review_name" class="form-label fw-semibold">Name</label>
                                                <input type="text" class="form-control" id="update_review_name" name="update_review_name" placeholder="Enter Name" required>
                                                <input type="text" hidden class="form-control" id="update_review_id" name="update_review_id" placeholder="Enter Name" required>
                                            </div>

                                            <div class="mb-3">
                                                <label for="review_email" class="form-label fw-semibold">Email</label>
                                                <input type="email" class="form-control" id="update_review_email" name="update_review_email" placeholder="Enter Email" required>
                                            </div>

                                            <div class="mb-3 form-check">
                                                <input type="checkbox" class="form-check-input" id="update_reviews_showhide" name="update_reviews_showhide">
                                                <label class="form-check-label fw-semibold" for="update_reviews_showhide">Show / Hide</label>
                                            </div>

                                            <!-- ⭐ Star Rating Section -->
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold d-block">Rating</label>
                                                <div class="updatestar-rating">
                                                    <input type="radio" id="update_star5" name="update_reviews_rating" value="5" required>
                                                    <label for="update_star5" title="5 stars">&#9733;</label>

                                                    <input type="radio" id="update_star4" name="update_reviews_rating" value="4">
                                                    <label for="update_star4" title="4 stars">&#9733;</label>

                                                    <input type="radio" id="update_star3" name="update_reviews_rating" value="3">
                                                    <label for="update_star3" title="3 stars">&#9733;</label>

                                                    <input type="radio" id="update_star2" name="update_reviews_rating" value="2">
                                                    <label for="update_star2" title="2 stars">&#9733;</label>

                                                    <input type="radio" id="update_star1" name="update_reviews_rating" value="1">
                                                    <label for="update_star1" title="1 star">&#9733;</label>
                                                </div>

                                            </div>

                                            <div class="mb-3">
                                                <label for="reviews_meseje" class="form-label fw-semibold">Message</label>
                                                <textarea class="form-control" id="update_reviews_meseje" name="update_reviews_meseje" placeholder="Message" rows="4" required></textarea>
                                            </div>

                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-premium btn-premium-primary btn-lg shadow-sm">Submit</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        
                            <div class="table-responsive" id="reviweslist">
                                <table id="reviews-session-tabel" class="display nowrap">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Star</th>
                                            <th>Show/Hide</th>
                                            <th>Message</th>
                                            <!-- <th>Product</th> -->
                                            <th>Date & Time</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for a in reviews %}
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img loading="lazy" src="{% if a.user.profile_image %}{{a.user.profile_image.url}}{% else %}/static/images/user_profile.png{% endif %}"
                                                        class="user-avatar me-2 rounded-circle" width="40" height="40" alt="User">
                                                    {{ a.name }}
                                                </div>
                                            </td>

                                            <td>{{ a.email }}</td>

                                            <!-- ⭐ Star Rating Display -->
                                            <td>
                                                {% for i in "12345" %}
                                                    {% if forloop.counter <= a.star|add:"0" %}
                                                        <i class="fa-solid fa-star text-warning"></i>
                                                    {% else %}
                                                        <i class="fa-regular fa-star text-muted"></i>
                                                    {% endif %}
                                                {% endfor %}
                                            </td>

                                            <td>
                                                 <input type="checkbox" style="width: 18px; height: 18px; cursor: pointer;" onclick="toggleReviewShow({{ a.id }}, this)" {% if a.show %}checked{% endif %}>
                                             </td>

                                            <td>{{ a.msg }}</td>

                                            <!-- <td>
                                                <img class="user-avatar rounded" width="100" height="100" src="{{ a.product.product_image.url }}" alt="product">
                                            </td> -->

                                            <td>{{ a.created_at|date:"Y-m-d H:i" }}</td>

                                            <td>
                                                <button class="btn btn-sm btn-premium btn-premium-primary" onclick="review_edit_form(`{{a.name}}`,`{{a.email}}`,'{{a.msg}}',{{a.star}},`{{a.show}}`,{{a.id}})">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>
                                                <button class="btn btn-sm btn-premium btn-premium-outline" onclick="review_delete({{ a.id }}, this)">
                                                    <i class="fa-solid fa-trash"></i> 
                                                </button>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Abandoned Checkouts Section -->
                <div class="content-section" id="abandonedcheckouts-section">
                    <div class="page-header"><h1>Abandoned Checkouts</h1></div>
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Amount</th><th>Date</th></tr></thead>
                                    <tbody>
                                        {% for a in abandoned_checkouts %}
                                        <tr><td>{{ a.first_name }} {{ a.last_name }}</td><td>{{ a.email }}</td><td>{{ a.phone }}</td><td>₹{{ a.amount }}</td><td>{{ a.created_at|date:"d M Y" }}</td></tr>
                                        {% empty %}
                                        <tr><td colspan="5" class="text-center text-muted py-4">No abandoned checkouts.</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Returns & Cancellations Section -->
                <div class="content-section" id="returns-section">
                    <div class="page-header"><h1>Returns & Cancellations</h1></div>
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead><tr><th>Order</th><th>Product</th><th>Reason</th><th>Type</th><th>Date</th></tr></thead>
                                    <tbody>
                                        {% for a in return_requests %}
                                        <tr>
                                            <td>{{ a.orders.order_id }}</td>
                                            <td><div class="fw-bold small text-truncate" style="max-width:200px;">{{ a.orders.product.product_name }}</div></td>
                                            <td>{{ a.reason|truncatechars:30 }}</td>
                                            <td><span class="badge {% if a.cancel_request %}bg-danger-subtle text-danger{% else %}bg-warning-subtle text-warning{% endif %} px-3 py-1 rounded-pill">{% if a.cancel_request %}Cancellation{% else %}Return{% endif %}</span></td>
                                            <td>{{ a.created_at|date:"d M Y" }}</td>
                                        </tr>
                                        {% empty %}
                                        <tr><td colspan="5" class="text-center text-muted py-4">No return or cancellation requests.</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Carousel Banners Section -->
                <div class="content-section" id="banners-section">
                    <div class="page-header">
                        <h1>Carousel Banners</h1>
                        <button class="btn btn-premium btn-premium-gold" data-bs-toggle="modal" data-bs-target="#addBannerModal"><i class="fas fa-plus"></i> Add Banner</button>
                    </div>
                    <div class="row g-3">
                        {% for a in banners %}
                        <div class="col-md-4 col-6">
                            <div class="card border-0 shadow-sm position-relative">
                                {% if a.image %}<img src="{{ a.image.url }}" class="card-img-top" style="height:150px;object-fit:cover;">{% endif %}
                                <div class="card-body p-2 text-center">
                                    <button class="btn btn-action-delete btn-sm" onclick="deleteBanner({{ a.id }}, this)" title="Delete"><i class="fas fa-trash"></i></button>
                                </div>
                            </div>
                        </div>
                        {% empty %}
                        <div class="col-12 text-center text-muted py-4">No banners yet.</div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Testimonials Section -->
                <div class="content-section" id="testimonials-section">
                    <div class="page-header">
                        <h1>Testimonials</h1>
                        <button class="btn btn-premium btn-premium-gold" data-bs-toggle="modal" data-bs-target="#addTestimonialModal"><i class="fas fa-plus"></i> Add Testimonial</button>
                    </div>
                    <div class="row g-3">
                        {% for a in testimonials %}
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center">
                                    {% if a.image %}<img src="{{ a.image.url }}" class="rounded-circle mb-2" width="60" height="60" style="object-fit:cover;">{% endif %}
                                    <h6 class="fw-bold mb-0">{{ a.name }}</h6>
                                    <small class="text-muted">{{ a.company_name }}</small>
                                    <p class="small mt-2">{{ a.content|truncatechars:80 }}</p>
                                    <button class="btn btn-sm btn-action-delete" onclick="deleteTestimonial({{ a.id }}, this)" title="Delete"><i class="fas fa-trash"></i></button>
                                </div>
                            </div>
                        </div>
                        {% empty %}
                        <div class="col-12 text-center text-muted py-4">No testimonials yet.</div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Trusted Clients Section -->
                <div class="content-section" id="trustedclients-section">
                    <div class="page-header">
                        <h1>Trusted Clients</h1>
                        <button class="btn btn-premium btn-premium-gold" data-bs-toggle="modal" data-bs-target="#addClientModal"><i class="fas fa-plus"></i> Add Client</button>
                    </div>
                    <div class="row g-3">
                        {% for a in trusted_clients %}
                        <div class="col-md-3 col-4">
                            <div class="card border-0 shadow-sm text-center p-3">
                                {% if a.image %}<img src="{{ a.image.url }}" class="img-fluid" style="height:50px;object-fit:contain;">{% endif %}
                                <button class="btn btn-sm btn-action-delete mt-2" onclick="deleteTrustedClient({{ a.id }}, this)" title="Delete"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                        {% empty %}
                        <div class="col-12 text-center text-muted py-4">No trusted clients yet.</div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Instagram Feed Section -->
                <div class="content-section" id="instagram-section">
                    <div class="page-header">
                        <h1>Instagram Feed</h1>
                        <button class="btn btn-premium btn-premium-gold" data-bs-toggle="modal" data-bs-target="#addInstaModal"><i class="fas fa-plus"></i> Add Image</button>
                    </div>
                    <div class="row g-3">
                        {% for a in insta_images %}
                        <div class="col-md-3 col-4">
                            <div class="card border-0 shadow-sm">
                                {% if a.image %}<img src="{{ a.image.url }}" class="card-img-top" style="height:180px;object-fit:cover;">{% endif %}
                                <div class="card-body p-2 text-center">
                                    <button class="btn btn-sm btn-action-delete" onclick="deleteInstaImage({{ a.id }}, this)" title="Delete"><i class="fas fa-trash"></i></button>
                                </div>
                            </div>
                        </div>
                        {% empty %}
                        <div class="col-12 text-center text-muted py-4">No Instagram images yet.</div>
                        {% endfor %}
                    </div>
                </div>

                <!-- A+ Listings Section -->
                <div class="content-section" id="aplus-section">
                    <div class="page-header">
                        <h1>A+ Listings</h1>
                        <button class="btn btn-premium btn-premium-gold" data-bs-toggle="modal" data-bs-target="#addAplusModal"><i class="fas fa-plus"></i> Add Asset</button>
                    </div>
                    <div class="row g-3">
                        {% for a in aplus_listings %}
                        <div class="col-md-3 col-4">
                            <div class="card border-0 shadow-sm">
                                {% if a.image %}<img src="{{ a.image.url }}" class="card-img-top" style="height:150px;object-fit:cover;">{% endif %}
                                <div class="card-body p-2 text-center">
                                    <button class="btn btn-sm btn-action-delete" onclick="deleteAplusListing({{ a.id }}, this)" title="Delete"><i class="fas fa-trash"></i></button>
                                </div>
                            </div>
                        </div>
                        {% empty %}
                        <div class="col-12 text-center text-muted py-4">No A+ listings yet.</div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Contact Messages Section -->
                <div class="content-section" id="contacts-section">
                    <div class="page-header"><h1>Contact Messages</h1></div>
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Message</th><th>Date</th><th>Action</th></tr></thead>
                                    <tbody>
                                        {% for a in contact_messages %}
                                        <tr>
                                            <td>{{ a.name }}</td><td>{{ a.email }}</td><td>{{ a.phone }}</td>
                                            <td><div class="text-truncate" style="max-width:200px;">{{ a.message }}</div></td>
                                            <td>{{ a.created_at|date:"d M Y" }}</td>
                                            <td><button class="btn btn-sm btn-action-delete" onclick="deleteContactMsg({{ a.id }}, this)" title="Delete"><i class="fas fa-trash"></i></button></td>
                                        </tr>
                                        {% empty %}
                                        <tr><td colspan="6" class="text-center text-muted py-4">No messages yet.</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- API Keys Section -->
                <div class="content-section" id="apikeys-section">
                    <div class="page-header">
                        <h1>API Keys</h1>
                        <button class="btn btn-premium btn-premium-gold" data-bs-toggle="modal" data-bs-target="#generateApiKeyModal"><i class="fas fa-key"></i> Generate Key</button>
                    </div>
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead><tr><th>Key Name</th><th>API Key</th><th>Created</th><th>Action</th></tr></thead>
                                    <tbody>
                                        {% for a in api_keys %}
                                        <tr>
                                            <td>{{ a.key_name }}</td>
                                            <td><code>{{ a.key }}</code></td>
                                            <td>{{ a.created_at|date:"d M Y" }}</td>
                                            <td><button class="btn btn-sm btn-action-delete" onclick="deleteApiKey({{ a.id }}, this)" title="Delete"><i class="fas fa-trash"></i></button></td>
                                        </tr>
                                        {% empty %}
                                        <tr><td colspan="4" class="text-center text-muted py-4">No API keys generated yet.</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            <div class="p-3 border-top text-center">
                                <button class="btn btn-premium btn-premium-outline btn-sm" data-bs-toggle="modal" data-bs-target="#apiDocumentationModal"><i class="fas fa-book me-1"></i> View API Documentation</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Blog Posts & Category Section -->
                <div class="content-section" id="blogs-section">
                    <div class="page-header">
                        <h1>Blog Management</h1>
                        <div>
                            <button class="btn btn-premium btn-premium-outline" data-bs-toggle="modal" data-bs-target="#addBlogCategoryModal">
                                <i class="fas fa-tag"></i> Add Category
                            </button>
                            <button class="btn btn-premium btn-premium-gold" data-bs-toggle="modal" data-bs-target="#addBlogPostModal">
                                <i class="fas fa-plus"></i> Add Blog Post
                            </button>
                        </div>
                    </div>

                    <!-- Blog Categories -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-tags me-2"></i>Blog Categories</span>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3">{{ blog_categories|length }} Categories</span>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                {% for cat in blog_categories %}
                                <div class="col-md-3 col-6">
                                    <div class="d-flex justify-content-between align-items-center bg-light rounded-3 px-3 py-2">
                                        <span class="fw-semibold small">{{ cat.category }}</span>
                                        <button class="btn btn-sm text-danger border-0" onclick="deleteBlogCategory({{ cat.id }}, this)" title="Delete">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                {% empty %}
                                <div class="col-12 text-center text-muted py-3">No blog categories yet. Create one!</div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <!-- Blog Posts List -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span><i class="fas fa-newspaper me-2"></i>All Blog Posts</span>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3">{{ blog_posts|length }} Posts</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Image</th>
                                            <th>Title</th>
                                            <th>Category</th>
                                            <th>Author</th>
                                            <th>Date</th>
                                            <th style="width:120px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for post in blog_posts %}
                                        <tr>
                                            <td>
                                                <div class="blog-img-wrapper">
                                                    {% if post.blog_image %}
                                                    <img src="{{ post.blog_image.url }}" class="rounded-3 border">
                                                    {% endif %}
                                                </div>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ post.meta_title }}</div>
                                                <div class="text-muted small">{{ post.meta_description|truncatechars:60 }}</div>
                                            </td>
                                            <td><span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill">{{ post.category.category }}</span></td>
                                            <td>{{ post.author }}</td>
                                            <td>{{ post.date|date:"d M Y" }}</td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <a href="/blogs/{{ post.slug }}" target="_blank" class="btn btn-action-view" title="View"><i class="fas fa-eye"></i></a>
                                                    <button class="btn btn-action-delete" onclick="deleteBlogPost({{ post.id }}, this)" title="Delete"><i class="fas fa-trash"></i></button>
                                                </div>
                                            </td>
                                        </tr>
                                        {% empty %}
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                <i class="fas fa-book-open mb-2" style="font-size:2rem; opacity:0.3;"></i>
                                                <div>No blog posts yet. Click "Add Blog Post" to create one!</div>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Analytics Section -->
                <div class="content-section" id="analytics-section">
                    <div class="page-header">
                        <h1>Business Analytics</h1>
                    </div>

                    <div class="row g-4">
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-transparent py-3">
                                    <h6 class="fw-bold mb-0">Sales Overview</h6>
                                </div>
                                <div class="card-body">
                                    <div style="height: 300px; width: 100%;">
                                        <canvas id="analyticsSalesChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-transparent py-3">
                                    <h6 class="fw-bold mb-0">Traffic Sources</h6>
                                </div>
                                <div class="card-body">
                                    <div style="height: 300px; width: 100%;">
                                        <canvas id="analyticsTrafficChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4 g-4">
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-transparent py-3">
                                    <h6 class="fw-bold mb-0">Top Products by Price</h6>
                                </div>
                                <div class="card-body p-0">
                                    <ul class="list-group list-group-flush">
                                        {% for p in products_all|slice:":5" %}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3 border-0">
                                            <div class="d-flex align-items-center gap-3">
                                                {% if p.product_image %}
                                                <img src="{{ p.product_image.url }}" width="40" height="40" class="rounded-3 border" style="object-fit: cover;">
                                                {% else %}
                                                <img src="/static/product_select_img.png" width="40" height="40" class="rounded-3 border" style="object-fit: cover;">
                                                {% endif %}
                                                <div class="fw-semibold text-dark" style="font-size: 0.9rem;">{{ p.product_name|truncatechars:35 }}</div>
                                            </div>
                                            <span class="badge bg-success-subtle text-success rounded-pill px-3">₹{{ p.b2c_price }}</span>
                                        </li>
                                        {% empty %}
                                        <li class="list-group-item text-center text-muted py-4">No products.</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-transparent py-3">
                                    <h6 class="fw-bold mb-0">Customer Demographics</h6>
                                </div>
                                <div class="card-body">
                                    <div style="height: 300px; width: 100%;">
                                        <canvas id="analyticsDemographicsChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Settings Section -->
                <!-- Add new category  -->

    <div class="modal fade" id="addnewcategory" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">Add New Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="categoryForm" enctype="multipart/form-data" method="post">
                        {% csrf_token %}
                        <input type="file" accept="image/*" name="category_image" class="form-control"
                            id="category_image" required>
                        <input type="text" name="category_name" id="category_name" class="form-control my-2"
                            placeholder="Category Name" required>
                                        <button type="button" class="btn btn-sm btn-premium btn-premium-gold" class="form-control my-2"
                                            onclick="submitCategory()">Add Category</button>
                    </form>


                </div>

            </div>
        </div>
    </div>
    <!-- Add new sub category  -->

    <div class="modal fade" id="addnewsubcategory" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
        aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">Add New Sub Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="subcategoryForm" enctype="multipart/form-data" method="post">
                        {% csrf_token %}
                        <input type="file" accept="image/*" name="sub_category_image" class="form-control"
                            id="category_image" required>
                        <input type="text" name="sub_category_name" id="sub_category_name" class="form-control my-2"
                            placeholder="Category Name" required>
                                        <button type="button" class="btn btn-sm btn-premium btn-premium-gold" class="form-control my-2"
                                            onclick="submitsubCategory()">Add Category</button>
                    </form>


                </div>

            </div>
        </div>
    </div>
    <div class="modal fade" id="subcategorymodeledit" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Edit Sub Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form method="post" id="editosubcategoryform" enctype="multipart/form-data">
                        {% csrf_token %}

                        <input type="file" accept="image/*" name="subeditcategory_image" class="form-control"
                            id="subeditcategory_image" placeholder="Select Category Image" required><br>

                        <input type="text" name="subeditcategory" id="subeditcategory" class="form-control my-2"
                            placeholder="Enter Category Name" required><br>
                        <input type="text" hidden name="subeditcategoryid" id="subeditcategoryid" class="form-control" 
                            placeholder="Enter Category ID " required>
                                        <button class="btn btn-sm btn-premium btn-premium-gold me-2 my-2" onclick="Edit_sub_category()">Edit
                                            Category</button>

                    </form>
                </div>

            </div>
        </div>
    </div>
    <!-- Category model 
  -->
    <!-- Button trigger modal -->
    <!-- Modal -->
    <div class="modal fade" id="categorymodel" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Edit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form method="post" id="editocategoryform" enctype="multipart/form-data">
                        {% csrf_token %}

                        <input type="file" accept="image/*" name="editcategory_image" class="form-control"
                            id="editcategory_image" placeholder="Select Category Image" required><br>

                        <input type="text" name="editcategory" id="editcategory" class="form-control my-2"
                            placeholder="Enter Category Name" required><br>
                        <input type="text" name="editcategoryid" id="editcategoryid" class="form-control" hidden
                            placeholder="Enter Category ID " required>
                                        <button class="btn btn-sm btn-premium btn-premium-gold me-2 my-2" onclick="Edit_category()">Edit
                                            Category</button>

                    </form>
                </div>

            </div>
        </div>
    </div>
    <!-- Order Status Modal -->
    
    <!-- API Documentation Modal -->
    <div class="modal fade" id="apiDocumentationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-dark"><i class="fas fa-book me-2"></i>API Sync Integration Guide</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height: calc(100vh - 200px); overflow-y: auto;">
                    <h6 class="fw-bold text-dark">Overview</h6>
                    <p class="text-secondary small">This API allows third-party websites to sync and display your streetwear products in real-time. All responses are in standard JSON format.</p>
                    
                    <h6 class="fw-bold text-dark mt-4">1. API Endpoint & Auth</h6>
                    <p class="text-secondary small mb-2">You can authenticate requests by passing your generated API token key via the URL parameter or as an HTTP request header.</p>
                    <div class="bg-light p-3 rounded mb-3">
                        <code style="font-size: 0.85rem; color: #052043;">GET /api/v1/products/?api_key=YOUR_API_KEY</code>
                    </div>
                    
                    <h6 class="fw-bold text-dark mt-4">2. Javascript Fetch Code Example</h6>
                    <p class="text-secondary small mb-2">Simply copy and paste the following snippet on any website to fetch and render products dynamically:</p>
                    <pre class="bg-dark text-white p-3 rounded small" style="font-family: monospace;">
const api_key = "YOUR_API_KEY";
const api_url = `https://${window.location.host}/api/v1/products/?api_key=${api_key}`;

fetch(api_url)
  .then(response => response.json())
  .then(data => {
    if (data.status === "success") {
      console.log("Loaded products:", data.products);
      // Example: Loop and append to your HTML grid
      let container = document.getElementById("product-grid");
      data.products.forEach(p => {
        container.innerHTML += `
          &lt;div class="product-card"&gt;
            &lt;img src="${p.image_url}" alt="${p.name}" width="150"&gt;
            &lt;h5&gt;${p.name}&lt;/h5&gt;
            &lt;p&gt;Price: INR ${p.price_b2c}&lt;/p&gt;
          &lt;/div&gt;
        `;
      });
    }
  })
  .catch(err => console.error("Sync error:", err));
                    </pre>

                    <h6 class="fw-bold text-dark mt-4">3. Products JSON Schema</h6>
                    <pre class="bg-light p-3 rounded small text-secondary" style="font-family: monospace; font-size: 0.8rem;">
{
  "status": "success",
  "total_results": 1,
  "products": [
    {
      "id": 12,
      "name": "US Vesta Men's Oversized Fit Black T-Shirt",
      "sku": "VESTA-BLK-001",
      "category": "Oversized Fit",
      "price_b2c": "449.00",
      "price_b2b": "350.00",
      "brand": "US VESTA",
      "image_url": "https://yourdomain.com/media/products/oversized-black.webp",
      "colors": ["Black", "White"],
      "sizes": ["M", "L", "XL", "XXL"]
    }
  ]
}
                    </pre>
                </div>
            </div>
        </div>
    </div>

    <!-- Generate API Key Modal -->
    <div class="modal fade" id="generateApiKeyModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generate API Key</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="apiTokenForm" onsubmit="event.preventDefault(); submitApiKeyForm(this);">
                        {% csrf_token %}
                        <div class="mb-3">
                            <label class="form-label">Key Name / Description</label>
                            <input type="text" name="key_name" class="form-control" placeholder="e.g. Partner Website Integration" required>
                        </div>
                        <input type="hidden" name="create_api_key" value="true">
                        <button type="submit" class="btn btn-premium btn-premium-primary w-100">Generate Token</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Banner Modal -->
    <div class="modal fade" id="addBannerModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Carousel Banner</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="bannerForm" enctype="multipart/form-data" onsubmit="event.preventDefault(); submitBannerForm(this);">
                        {% csrf_token %}
                        <input type="hidden" name="banner_action" value="add">
                        <div class="mb-3">
                            <label class="form-label">Desktop Banner Image</label>
                            <input type="file" name="banner_image" accept="image/*" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mobile Banner Image</label>
                            <input type="file" name="banner_image_phone" accept="image/*" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Banner Video (Optional)</label>
                            <input type="file" name="banner_video" accept="video/*" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Alt Name / Keywords</label>
                            <input type="text" name="banner_alt" class="form-control" required placeholder="e.g. Trendy Oversized T-Shirts Sale">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Map to Sub Category (Optional)</label>
                            <select name="banner_sub_cat" class="form-select">
                                <option value="">None (Generic Banner)</option>
                                {% for sc in sub_cat %}
                                <option value="{{ sc.id }}">{{ sc.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Show on Pages (Hold Ctrl to select multiple)</label>
                            <select name="banner_pages" class="form-select" multiple required style="height: 120px;">
                                <option value="/" selected>Home Page</option>
                                <option value="/our-story">Our Story Page</option>
                                <option value="/shop">Shop Page</option>
                                <option value="/contact-us">Contact US</option>
                                <option value="/for-corporates">For Corporates Page B2B</option>
                                <option value="/blog">Blogs</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-premium btn-premium-primary w-100">Add Banner</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Testimonial Modal -->
    <div class="modal fade" id="addTestimonialModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Testimonial</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
