<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>US Vesta Admin Panel - E-commerce Store</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.2/css/buttons.dataTables.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/static/assets/css/dashboard.css">
    <link href='https://cdn.jsdelivr.net/npm/froala-editor@latest/css/froala_editor.pkgd.min.css' rel='stylesheet'
        type='text/css' />
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
</head>

<body>
    <div class="mx-5">
        <div class="page-header">
            <h1>Add New Product</h1>

            <div>
                <a href="/usvesta-deshboard" class="btn btn-outline-primary me-2" onclick="add_product_form()">
                    <i class="fas fa-arrow-left me-1"></i> GO Back
                </a>
                
            </div>

        </div>
        <form id="updetedproductForm" method="post" class="d-block" enctype="multipart/form-data">
            {% csrf_token %}
            <input type="text" hidden value="{{request.path}}" name="" id="url_for_pasing_data">
            <input type="text" hidden value="{{product_type}}" name="" id="product_type">

            <div class="row">
                <div class="col-lg-8">
                    <!-- Basic Information Card -->
                    <div class="card">
                        <div class="card-header">
                            Basic Information
                        </div>
                        <div class="card-body">

                            <div class="mb-3">
                                <label for="productName" class="form-label">Product Name</label>
                                <input type="text" class="form-control" id="productName"
                                    placeholder="Enter product name" value="{{a.product_name}}{{a.product.product_name}}" required>
                            </div>
                            <div class="mb-3">
                                <label for="productDescription" class="form-label">Description</label>
                                <textarea class="form-control" id="productDescription" rows="5"
                                    placeholder="Enter product description">
                                {{a.product_description}}{{a.product.product_description}}
                                </textarea>
                            </div>
                            <div class="mb-3">
                                <label for="productDescription" class="form-label"> Highlight</label>
                                <textarea class="form-control" id="productHighlight" rows="5"
                                    placeholder="Enter product Highlight">
                                  {{a.highlight}}{{a.product.highlight}}
                                </textarea>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productCategory" class="form-label">Sub Category</label>
                                        <select class="form-select" id="productCategory" required>
                                            <option value="{{a.sub_category.id}}{{a.product.sub_category.id}}" selected>{{a.sub_category.name}}{{a.product.sub_category.name}}</option>

                                            {% for a in subcategory %}
                                                <option value="{{a.id}}">{{a.name}}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productBrand" class="form-label">Brand</label>
                                        <input type="text" class="form-control" value="{{a.brand}}{{a.product.brand}}" id="productBrand"
                                            placeholder="Enter brand name">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productBrand" class="form-label"> Ratings </label>
                                        <input type="text" class="form-control" value="{{a.ratings}}{{a.product.ratings}}" id="productratings"
                                            placeholder="Enter Ratings">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productBrand" class="form-label">Total Sale
                                            Products</label>
                                        <input type="text" class="form-control" id="total_sale_product"
                                            placeholder="Enter Total Sale Products"  value="{{a.total_sale_products}}{{a.product.total_sale_products}}">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productCategory" class="form-label"> T shirt type
                                        </label>
                                        <select class="form-select" id="t-shirt-type" required>
                                            <option value="{{a.t_shirt_type}}{{a.product.t_shirt_type}}" selected>{{a.t_shirt_type}}{{a.product.t_shirt_type}}</option>

                                            <option value="Collar Neck T Shirt">Collar Neck T Shirt</option>
                                            <option value="Round Neck T Shirt">Round Neck T Shirt</option>

                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productBrand" class="form-label">Key Words</label>
                                        <input type="text" class="form-control" id="key_word"
                                            placeholder="Enter Key Words"  value="{{a.key_words}}{{a.product.key_words}}">
                                    </div>
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productBrand" class="form-label">Offer Product Quantity</label>
                                        <input type="text" class="form-control" id="product_quantity_offer"
                                            placeholder="Enter Offer Product Quantity"  value="{{a.product_quantity_offer}}{{a.product.product_quantity_offer}}">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productBrand" class="form-label">Offer Product Amount</label>
                                        <input type="text" class="form-control" id="product_amount_offer"
                                            placeholder="Enter Offer Product Amount"  value="{{a.product_amount_offer}}{{a.product.product_amount_offer}}">
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Pricing & Inventory Card -->
                    <div class="card">
                        <div class="card-header">
                            Pricing & Inventory
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productPrice" class="form-label">Sale Price</label>
                                        <div class="price-input-group">
                                            <span>₹</span>
                                            <input type="number" class="form-control" value="{{a.b2c_price}}{{a.product.b2c_price}}" id="sale-Price" placeholder="0.00"
                                                step="0.01" min="0" required>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productComparePrice" class="form-label">Regular
                                            price</label>
                                        <div class="price-input-group">
                                            <span>₹</span>
                                            <input type="number" class="form-control" id="regularPrice"
                                                placeholder="0.00" step="0.01" min="0" value="{{a.discount_price}}{{a.product.discount_price}}">
                                        </div>
                                        <div class="form-text"></div>
                                    </div>
                                </div>
                            </div>

                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productQuantity" class="form-label">Color</label>
                                        <input type="text" class="form-control" id="product-color" placeholder="0"
                                            min="0" required value="{% if product_type == "inner-product" %}{{a.product.color}} {% elif product_type == "product" %}{{a.color}}{% endif %}">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productBarcode" class="form-label">Color Code</label>
                                        <input type="text" class="form-control" value="{% if product_type == "inner-product" %}{{a.product.color_code}} {% elif product_type == "product" %}{{a.color_code}} {% endif %}" id="product-color-code">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productQuantity" class="form-label">Product
                                            Image</label>
                                        <input type="file" value="{{a.product_image.url}}{{a.product.product_image.url}}" class="form-control" id="product_image" >
                                         <img loading="lazy" width="70" height="70"
                                                        src="{{a.product_image.url}}{{a.product.product_image.url}}"
                                                        alt="p">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="productBarcode" class="form-label">Image ALT
                                            Name</label>
                                        <input type="text" class="form-control" id="imagealtname" value="{{a.product_image_alt}}{{a.product.product_name}}">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Product Images Card -->
                    <div class="card">
                        <div class="card-header">
                            Product Gallery Images
                        </div>
                        <div class="card-body">
                            <div class="image-preview-container" id="imagePreviewContainer">
                                <p>Selected Images</p><br>
                                {% for c in product_gellery_image %}
                                <img src="{{c.image.url}}" alt="p" width="70" class="m-2"
                                    height="70">
                                {% endfor %}
                            </div>
                            <div class="image-upload-area" id="imageUploadArea">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <h5>Drag & Drop images here</h5>
                                <p class="text-muted">or</p>
                                <button type="button" class="btn btn-primary" id="uploadImageBtn">
                                    <i class="fas fa-folder-open me-1"></i> Browse Files
                                </button>
                                <input type="file" id="imageInput" multiple accept="image/*" style="display: none;">
                            </div>
                        </div>
                    </div>
                    <!-- Color Variants Card -->
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>Color Variants</span>
                            <button type="button" class="btn btn-sm btn-primary" id="addColorVariant">
                                <i class="fas fa-plus me-1"></i> Add Color
                            </button>
                        </div>
                        <div class="card-body">
                            <div class="color-variants-container" id="colorVariantsContainer">
                                <!-- Color variants will be added here dynamically -->




                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Status Card -->
                     <div class="sticky-top" style="top: 20px;"> 
                    <div class="card">
                        <div class="card-header">
                            Status
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Product Status</label>
                                <div class="d-flex align-items-center">
                                    <label class="toggle-switch me-3">
                                        <input type="checkbox" id="productStatus" {% if a.product_status == "Publish" or a.product.product_status == "Publish" %} checked {% endif %}>
                                        <span class="toggle-slider"></span>
                                    </label>
                                    <span id="statusText" class="status-badge status-active">Active</span>
                                </div>
                                <div class="form-text">Only active products are visible to customers.</div>
                            </div>


                            <div class="mb-3">
                                <label class="form-label"> Top 8 products </label>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="onlineStore" {% if a.top_eight_products or a.product.top_eight_products %} checked {% endif %}>
                                    <label class="form-check-label" for="onlineStore">
                                        Only active products are visible At Home.
                                    </label>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Size</label>
                                {% for size in all_sizes %}
                                    <div class="form-check">
                                        <input 
                                            class="form-check-input"
                                            type="checkbox"
                                            name="sizes"
                                            value="{{ size }}"
                                            id="size_{{ size }}"
                                            {% if size in available_sizes %}checked{% endif %}
                                        >
                                        <label class="form-check-label" for="size_{{ size }}">
                                            {{ size }}
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>

                        </div>
                    </div>


                    <!-- Save Actions -->
                    <div class="card">
                        <div class="card-body">
                            <button type="submit" class="btn btn-primary w-100 mb-2">
                                <i class="fas fa-save me-1"></i> Update Product
                            </button>
                            <button type="button" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-times me-1"></i> Cancel
                            </button>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </form>

        
        <form method="post" class="my-2" enctype="multipart/form-data" id="color_verient_form_form_django">
            {% csrf_token %}
            <div class="row">
                <div class="col-lg-8">
                    <input type="hidden" name="product_type" value="{{ product_type }}">
                    <input type="hidden" name="main_product_id_for_color_variant_id" value="{% if product_type == "inner-product" %}{{ a.product.id }} {% elif product_type == "product" %}{{ a.id }}{% endif %}">

                    {% for a in color_product %}
                    <div class="card color-variant-card mb-4">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <label>Color Name</label>
                                    <input type="text" name="color_name[]" value="{{ a.color }}" class="form-control">
                                    <input type="hidden" name="color_variant_id[]" value="{{ a.id }}">
                                </div>
                                <div class="col-md-6">
                                    <label>Color Code</label>
                                    <input type="text" name="color_code[]" value="{{ a.color_code }}" class="form-control">
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <label>Product Image</label>
                                    <input type="file" name="color_image_{{forloop.counter0}}" class="form-control" accept="image/*">
                                    {% if a.color_images %}
                                        <img src="{{ a.color_images.url }}" width="70" height="70" class="mt-2">
                                    {% endif %}
                                </div>

                                <div class="col-md-6">
                                    <label>Gallery Images</label>
                                    <!-- Each gallery input has its own indexed name -->
                                    <input type="file" name="gallery_images_{{ forloop.counter0 }}[]" multiple class="form-control" accept="image/*">
                                    <div class="mt-2">
                                        {% for b in a.color_product_gelery_images_set.all %}
                                            <img src="{% if  b.image %}{{ b.image.url }}{% endif %}" width="70" height="70" class="me-2 mb-2">
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <div class="col-lg-4">
                <!-- Status Card -->
                    <div class="sticky-top" style="top: 20px;"> 
                        <!-- Save Actions -->
                        <div class="card">
                            <div class="card-body">
                                <button type="submit" class="btn btn-primary w-100 mb-2">
                                    <i class="fas fa-save me-1"></i> Update Color Variant Product
                                </button>
                            
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
            

        
                                    
    </div>
   <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.2/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script defer>
        
        // DataTable instance
        var table = new DataTable('#example', {
            layout: {
                topStart: {
                    buttons: [
                        {
                            extend: 'collection',
                            text: 'Filter by Status',
                            autoClose: true,  // This ensures dropdown closes after selection
                            buttons: [
                                {
                                    text: 'All',
                                    action: function (e, dt, node, config) {
                                        dt.column(9).search('').draw();
                                    }
                                },
                                {
                                    text: 'Ordered',
                                    action: function (e, dt, node, config) {
                                        dt.column(9).search('^Ordered$', true, false).draw();
                                    }
                                },
                                {
                                    text: 'Shipped',
                                    action: function (e, dt, node, config) {
                                        dt.column(9).search('^Shipped$', true, false).draw();
                                    }
                                },
                                {
                                    text: 'Delivered',
                                    action: function (e, dt, node, config) {
                                        dt.column(9).search('^Delivered$', true, false).draw();
                                    }
                                },
                                {
                                    text: 'Cancelled',
                                    action: function (e, dt, node, config) {
                                        dt.column(9).search('^Cancelled$', true, false).draw();
                                    }
                                },
                                {
                                    text: 'Return in process',
                                    action: function (e, dt, node, config) {
                                        dt.column(9).search('^Return in process$', true, false).draw();
                                    }
                                },
                                {
                                    text: 'Return Accepted',
                                    action: function (e, dt, node, config) {
                                        dt.column(9).search('^Return Accepted$', true, false).draw();
                                    }
                                },
                                {
                                    text: 'Return Rejected',
                                    action: function (e, dt, node, config) {
                                        dt.column(9).search('^Return Rejected$', true, false).draw();
                                    }
                                },
                                {
                                    text: 'Return',
                                    action: function (e, dt, node, config) {
                                        dt.column(9).search('^Return$', true, false).draw();
                                    }
                                },
                                {
                                    text: 'Refund',
                                    action: function (e, dt, node, config) {
                                        dt.column(9).search('^Refund$', true, false).draw();
                                    }
                                }
                            ]
                        },
                        'copy', 'csv', 'excel', 'pdf', 'print'
                    ]
                }
            },
            scrollY: 200,
            deferRender: true,
            scroller: true,
            responsive: true,
            select: true,
        });

        // Initialize popovers
        document.addEventListener('DOMContentLoaded', function () {
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
            popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl, {
                    container: 'body',
                    placement: 'right'
                });
            });

            document.addEventListener('click', function (e) {
                if (e.target.closest('[data-bs-toggle="popover"]') === null) {
                    var popovers = document.querySelectorAll('.popover');
                    popovers.forEach(function (popover) {
                        if (popover.style.display === 'block') {
                            bootstrap.Popover.getInstance(popover).hide();
                        }
                    });
                }
            });
        });

        // Open modal
        function set_order_st(pid) {
            var myModal = new bootstrap.Modal(document.getElementById('exampleModal003'));
            myModal.show();
            document.getElementById("product_id_set_order").value = pid;
        }
    </script>
    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/static/assets/js/dashboard.js"></script>
    <script type='text/javascript'
        src='https://cdn.jsdelivr.net/npm/froala-editor@latest/js/froala_editor.pkgd.min.js'></script>

<script>
    async function updategetAndSendProductData(urls_passing) {
    const formData = new FormData();
    const csrf_token = document.querySelector("[name='csrfmiddlewaretoken']").value;

    // --- Basic Information ---
    formData.append("name", document.getElementById("productName").value);
    formData.append("product_type", document.getElementById("product_type").value);

    formData.append("description", document.getElementById("productDescription").value);
    formData.append("highlight", document.getElementById("productHighlight").value);
    formData.append("category", document.getElementById("productCategory").value);
    formData.append("brand", document.getElementById("productBrand").value);
    formData.append("ratings", document.getElementById("productratings").value);
    formData.append("total_sale_product", document.getElementById("total_sale_product").value);
    formData.append("tshirt_type", document.getElementById("t-shirt-type").value);
    formData.append("keywords", document.getElementById("key_word").value);

    // --- Pricing & Inventory ---
    formData.append("sale_price", document.getElementById("sale-Price").value);
    formData.append("regular_price", document.getElementById("regularPrice").value);
    formData.append("color", document.getElementById("product-color").value);
    formData.append("color_code", document.getElementById("product-color-code").value);
    formData.append("product_amount_offer", document.getElementById("product_amount_offer").value);
    formData.append("product_quantity_offer", document.getElementById("product_quantity_offer").value);


    // --- Product Image ---
    const productImage = document.getElementById("product_image").files[0];
    if (productImage) formData.append("main_image", productImage);
    formData.append("image_alt", document.getElementById("imagealtname").value);

    // --- Status & Options ---
    formData.append("is_active", document.getElementById("productStatus").checked ? "true" : "false");
    formData.append("show_at_home", document.getElementById("onlineStore").checked ? "true" : "false");

    // --- Sizes (checkboxes) ---
    const sizes = [];
    document.querySelectorAll('.form-check-input[type="checkbox"][value]').forEach(chk => {
        if (chk.checked) sizes.push(chk.value);
    });
    formData.append("sizes", JSON.stringify(sizes));

    // --- MAIN PRODUCT GALLERY IMAGES - UPDATED ---
    console.log("Gallery files array:", galleryFiles);

    if (galleryFiles.length > 0) {
        galleryFiles.forEach((file, index) => {
            formData.append("gallery_images", file);
            console.log(`Added gallery image ${index}:`, file.name);
        });
    } else {
        console.log("No gallery images in galleryFiles array");
    }

    // --- COLOR VARIANTS ---
    const colorVariants = [];
    let variantIndex = 0;

    document.querySelectorAll('.color-variant-card').forEach(card => {
        const colorName = card.querySelector('.variant-color-name')?.value || '';
        const colorCode = card.querySelector('.variant-color-code')?.value || '';
        const imageAlt = card.querySelector('.variant-image-alt')?.value || '';
        const imageFile = card.querySelector('.variant-product-image')?.files[0] || null;

        // Get gallery files for this variant
        const galleryFiles = card.querySelector('.variant-gallery-images')?.files || [];

        // Add variant main image to formData
        if (imageFile) {
            formData.append(`variant_image_${variantIndex}`, imageFile);
        }

        // Add variant gallery images to formData
        for (let i = 0; i < galleryFiles.length; i++) {
            formData.append(`variant_gallery_${variantIndex}_${i}`, galleryFiles[i]);
        }

        colorVariants.push({
            color_name: colorName,
            color_code: colorCode,
            image_alt: imageAlt,
            variant_index: variantIndex,
            gallery_count: galleryFiles.length
        });

        variantIndex++;
    });

    formData.append("color_variants", JSON.stringify(colorVariants));


    // --- Send data to Django ---
    try {
        const response = await fetch(urls_passing, {
            method: "POST",
            body: formData,
            headers: { "X-CSRFToken": csrf_token }
        });

        if (response.ok) {
            const data = await response.json();
            swal({
                text: "✅ Product saved successfully!",
                icon: "success",
            })
            .then(window.location.reload())

            // Reset gallery files after successful submission
            galleryFiles = [];
            imagePreviewContainer.innerHTML = '';

        } else {
            swal({
                text: "❌ Error saving product.",
                icon: "error",
            })

        }
    } catch (error) {
        console.error("Network error:", error);
        alert();
        swal({
            text: "⚠️ Failed to send data to the server.",
            icon: "warning",
        })

    }
}




document.getElementById("updetedproductForm").addEventListener("submit", function (e) {
    e.preventDefault();
    let urls_passing=document.getElementById("url_for_pasing_data").value
    updategetAndSendProductData(urls_passing);
});

</script>


<script>
document.getElementById("color_verient_form_form_django").addEventListener("submit", function (e) {
    e.preventDefault();
    sendColorVariantForm();
});

function sendColorVariantForm() {
    const form = document.getElementById('color_verient_form_form_django');
    const formData = new FormData(form);
    const csrf_token = document.querySelector("[name='csrfmiddlewaretoken']").value;

    fetch("/usvesta-deshboard-veriant", {
        method: "POST",
        body: formData,
        headers: { "X-CSRFToken": csrf_token }
    })
    .then(res => res.json())
    .then(data => {
        swal({
            text: data.res,
            icon: data.status === "success" ? "success" : "error",
        }).then(window.location.reload())
    })
    .catch(() => {
        swal({
            text: "Something went wrong!",
            icon: "error",
        });
    });
}
</script>

</body>

</html>
