 <script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>
 
<script>

function showLoader() {
    let loader = document.getElementById("paymentLoader");
    if (loader) loader.style.display = "flex";
}

async function cashfree_fm() {

    const form = document.getElementById("checkoutForm");

    let input =
    document.getElementById("pproduct_total_bill") ||
    document.getElementById("product_total_bill");

    let t_amount = input ? input.value : 0;

    let csrf_token = document.querySelector("[name='csrfmiddlewaretoken']").value;

    let formdata = new FormData();
    formdata.append("chasfreeamount", t_amount);

    let response = await fetch("/create-cashfree-order", {
        method: "POST",
        body: formdata,

        headers:{
            "X-CSRFToken": csrf_token
        }
    });

    let data = await response.json();

    const cashfree = Cashfree({
        mode: "production"
    });

    cashfree.checkout({
        paymentSessionId: data.payment_session_id,
        redirectTarget: "_modal"
    }).then(function(result) {

        if (result.paymentDetails) {

            document.getElementById("chashfree_payment_id_usingdecstop").value="cash_free"
            document.getElementById("chashfree_order_id_usingdecstop").value="cash_free"
            form.submit();
            showLoader();
        }

        if (result.error) {

            console.log("Payment Failed");
            console.log(result.error);

        }

    });

}


async function phone_cashfree_fm() {

    const form = document.getElementById("checkoutForm_phone");
    const t_amount = document.getElementById("pproduct_total_bill").value;


    let csrf_token = document.querySelector("[name='csrfmiddlewaretoken']").value;

    let formdata = new FormData();
    formdata.append("chasfreeamount", t_amount);

    let response = await fetch("/create-cashfree-order", {
        method: "POST",
        body: formdata,
        headers:{
            "X-CSRFToken": csrf_token
        }
    });

    let data = await response.json();

    const cashfree = Cashfree({
        mode: "production"
    });

    cashfree.checkout({
        paymentSessionId: data.payment_session_id,
        redirectTarget: "_modal"
    }).then(function(result) {

        if (result.paymentDetails) {

            document.getElementById("cashfree_order_id_phone").value="cash_free"
            document.getElementById("cashfree_payment_id_phone").value="cash_free"
            form.submit();
            showLoader();

        }

        if (result.error) {

            console.log("Payment Failed");
            console.log(result.error);

        }

    });

}
</script>
<!-- Bootstrap JS -->
<script>
    // Payment method selection
    document.addEventListener('DOMContentLoaded', function () {
        const paymentMethods = document.querySelectorAll('.payment-method');

        paymentMethods.forEach(method => {
            method.addEventListener('click', function () {
                // Remove active class from all methods
                paymentMethods.forEach(m => m.classList.remove('active'));
                // Add active class to clicked method
                this.classList.add('active');
                // Check the corresponding radio button
                const radio = this.querySelector('input[type="radio"]');
                radio.checked = true;
            });
        });

        // Address selection
        const addressCards = document.querySelectorAll('.address-card');
        addressCards.forEach(card => {
            card.addEventListener('click', function () {
                // Remove active class from all cards
                addressCards.forEach(c => c.classList.remove('active'));
                // Add active class to clicked card
                this.classList.add('active');
            });
        });

        // Initialize totals
    });
</script>
<script>
// 🚀 PHONE ADDRESS DROPDOWN + ADD ADDRESS HANDLER
function initPhoneAddressSystem() {
    const changeBtn = document.getElementById("changeAddressBtn");
    const addressDropdown = document.getElementById("addressDropdown");

    function getAddressOptions() {
        return document.querySelectorAll(".address-option");
    }

    function updateButtonText() {
        if (getAddressOptions().length === 0) {
            changeBtn.textContent = "Add Address";
        } else {
            changeBtn.textContent = "Change";
        }
    }

    // Initial load
    updateButtonText();

    // 🌟 Global click handler
    document.addEventListener("click", function (e) {

        // -------------------------
        // 1️⃣ Change / Add Address / Close Button
        // -------------------------
        if (e.target.id === "changeAddressBtn") {

            const options = getAddressOptions();

            if (options.length === 0) {
                // Open Add Address Offcanvas (No address exists)
                const el = document.getElementById("offcanvasRightaddresphone");
                let offcanvas = new bootstrap.Offcanvas(el);
                offcanvas.show();
                return;
            }

            // Toggle dropdown
            addressDropdown.classList.toggle("show");

            // Set button text
            changeBtn.textContent = addressDropdown.classList.contains("show")
                ? "Close"
                : "Change";
        }

        // -------------------------
        // 2️⃣ Address Selection
        // -------------------------
        const option = e.target.closest(".address-option");
        if (option) {
            const selectedAddress = document.getElementById("selectedAddress");

            document.querySelectorAll(".address-option")
                .forEach(o => o.classList.remove("selected"));

            option.classList.add("selected");

            selectedAddress.innerHTML = option.innerHTML;

            addressDropdown.classList.remove("show");
            changeBtn.textContent = "Change";
        }

        // -------------------------
        // 3️⃣ Click outside → Close dropdown
        // -------------------------
        if (
            !e.target.closest(".address-header") &&
            !e.target.closest(".address-dropdown") &&
            !e.target.closest(".address-display")
        ) {
            addressDropdown?.classList.remove("show");

            if (getAddressOptions().length > 0) {
                changeBtn.textContent = "Change";
            }
        }
    });
}

// -------------------------
// 4️⃣ Reinitialize after HTMX swaps phone address list
// -------------------------
document.addEventListener("htmx:afterSwap", function (e) {
    if (e.target.id === "phone_address_list") {
        initPhoneAddressSystem();
    }
});

// -------------------------
// 5️⃣ Initialize on first load
// -------------------------
document.addEventListener("DOMContentLoaded", function () {
    initPhoneAddressSystem();
});
</script>









<script>
function check_address_axist_before_payment(){
    let selectedAddress = document.querySelector("#selectedAddress input[name='address_ids']");
    let selectedId = selectedAddress ? selectedAddress.value : null;

    if (!selectedId){
        swal({
            text: "Please select an address",
            icon: "error",
            buttons:{
                addAddress:{
                    text:"Add Address",
                    value:"address_val",
                },
            }
        })
        .then((value)=>{
            if(value === "address_val"){
                var el = document.getElementById('offcanvasRightaddresphone');
                let offcanvas = new bootstrap.Offcanvas(el); 
                offcanvas.show();     // ✔ this works
            }
        })
        return;
    }

    else{
        var el = document.getElementById('offcanvasRightpaymet_method');
        let offcanvas = new bootstrap.Offcanvas(el);
        offcanvas.show();   // ✔ this works
    }
}
</script>


<!-- Razorpay Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>



<script>
    function razorpay_fm_phone() {
        const isChecked = document.getElementById("ponerazorpay-paymnet").checked;
        const cashfree_payment_chek = document.getElementById("cashfree_payment_chek").checked;
        let selectedAddress = document.querySelector("#selectedAddress input[name='address_ids']");

        let selectedId = selectedAddress ? selectedAddress.value : null;
        if (!selectedId){
             swal({
                text: "Please select an address",
                icon: "error",
            })
            return;

        }
        // Select the form
        const form = document.getElementById("checkoutForm_phone");
        
        // Check validity of all required fields
        if (!form.checkValidity()) {
            form.reportValidity(); // Shows native browser error messages
            return; // Stop execution if invalid
        }

        if (isChecked){
            razorpay_getway_phone()
        }
        else if(cashfree_payment_chek){
            // cashfree_getway_phone()
            phone_cashfree_fm()
        }
        else {
            form.submit();
            showLoader() 

        }

    }
   
    function razorpay_getway_phone() {
      
        let t_amount = document.getElementById("pproduct_total_bill").value;

        var options = {
            "key": "{{ key_id }}",
            "amount": t_amount * 100,
            "currency": "INR",
            "name": "Us Vesta",
            "image": "/static/logo.png",
            "order_id": "{{ order_id }}",
            "handler": function (response) {
                document.getElementById("razorpay_payment_id").value = response.razorpay_payment_id
                document.getElementById("razorpay_order_id").value = response.razorpay_order_id

                form.submit();


            },
            "modal": {
                "ondismiss": function () {
                    let csrf_token = document.querySelector("[name='csrfmiddlewaretoken']").value;
                    let formdata = new FormData();

                    formdata.append("address_id_leave",selectedId);
                    

                    fetch("/checkout", {
                        method: "POST",
                        body: formdata,
                        headers: {
                            "X-CSRFToken": csrf_token
                            // ✅ Don't set Content-Type manually with FormData
                        }
                    });
                }
            }
            ,
            "prefill": {
                "name": "{{request.user.first_name}}",
                "email":'{{request.user.email}}',
                "contact":'{{request.user.phone}}'
            },
            "theme": {
                "color": "#022149"
            }
        };

        var rzp1 = new Razorpay(options);
        rzp1.open();
        
    }
  
    
    
    
    
    
    function razorpay_fm() {
        const freecash = document.getElementById("cash-free-payment").checked;

        const isChecked = document.getElementById("razorpay-paymnet").checked;
        let selectedAddress = document.querySelector('input[name="address_id"]:checked');
        if (!selectedAddress){
             swal({
                text: "Please select an address",
                icon: "error",
            })
            return;

        }

        // Select the form
        const form = document.getElementById("checkoutForm");

        // Check validity of all required fields
        if (!form.checkValidity()) {
            form.reportValidity(); // Shows native browser error messages
            return; // Stop execution if invalid
        }

        if (isChecked) {

           let input =
                document.getElementById("pproduct_total_bill") ||
                document.getElementById("product_total_bill");

            let t_amount = input ? input.value : 0;

            var options = {
                "key": "{{ key_id }}",
                "amount": t_amount * 100,
                "currency": "INR",
                "name": "Us Vesta",
                "image": "/static/logo.png",
                "order_id": "{{ order_id }}",
                "handler": function (response) {
                    document.getElementById("razorpay_payment_id").value = response.razorpay_payment_id
                    document.getElementById("razorpay_order_id").value = response.razorpay_order_id

                    form.submit();


                },
                "modal": {
                    "ondismiss": function () {
                        let csrf_token = document.querySelector("[name='csrfmiddlewaretoken']").value;
                        let formdata = new FormData();

                        formdata.append("address_id_leave", form['address_id'].value);
                        

                        fetch("/checkout", {
                            method: "POST",
                            body: formdata,
                            headers: {
                                "X-CSRFToken": csrf_token
                                // ✅ Don't set Content-Type manually with FormData
                            }
                        });
                    }
                }
                ,
                "prefill": {
                    "name": "{{request.user.first_name}}",
                    "email":'{{request.user.email}}',
                    "contact":'{{request.user.phone}}'
                },
                "theme": {
                    "color": "#022149"
                }
            };

            var rzp1 = new Razorpay(options);
            rzp1.open();
        } 
        else if(freecash){
            cashfree_fm()
            
        }
        else {
            form.submit();
        }
    }
</script>
