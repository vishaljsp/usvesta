<!-- Extra -->
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js" defer></script>
<script>
window.addEventListener("load", function () {
    let loader = document.getElementById("pageLoader");
    if(loader){
        // smooth fade out
        loader.style.opacity = "0";
        loader.style.transition = "0.4s";

        setTimeout(() => {
            loader.style.display = "none";
        }, 400);
    }
});

// Luxury Navbar Scroll Effect
document.addEventListener("DOMContentLoaded", () => {
    const navbar = document.querySelector(".luxury-navbar");
    const mobileHeader = document.querySelector(".luxury-mobile-header");
    const path = window.location.pathname;

    if (path === "/" || path === "/index.html" || path === "") {
        document.body.classList.add("home-page");
        
        const handleScroll = () => {
            if (window.scrollY > 30) {
                navbar?.classList.add("scrolled");
                mobileHeader?.classList.add("scrolled");
            } else {
                navbar?.classList.remove("scrolled");
                mobileHeader?.classList.remove("scrolled");
            }
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        handleScroll();
    } else {
        navbar?.classList.add("scrolled");
        mobileHeader?.classList.add("scrolled");
    }
});

// =========== GLOBAL TOAST NOTIFICATION ===========
(function() {
    var toastContainer = document.createElement('div');
    toastContainer.id = 'usvesta-toast-container';
    toastContainer.style.cssText = 'position:fixed;bottom:32px;left:50%;transform:translateX(-50%);z-index:9999;display:flex;flex-direction:column;align-items:center;gap:10px;pointer-events:none;';
    document.body.appendChild(toastContainer);

    window.showToast = function(msg, type) {
        var toast = document.createElement('div');
        var bg = (type === 'error') ? '#e24444' : (type === 'warning') ? '#C9A96E' : '#111111';
        toast.style.cssText = 'background:' + bg + ';color:#fff;padding:14px 28px;border-radius:100px;font-size:0.85rem;font-weight:400;letter-spacing:0.04em;opacity:0;transform:translateY(12px);transition:all 0.35s cubic-bezier(0.16,1,0.3,1);white-space:nowrap;box-shadow:0 8px 30px rgba(0,0,0,0.15);pointer-events:none;max-width:90vw;text-align:center;';
        toast.textContent = msg || 'Done!';
        toastContainer.appendChild(toast);
        requestAnimationFrame(function() {
            requestAnimationFrame(function() {
                toast.style.opacity = '1';
                toast.style.transform = 'translateY(0)';
            });
        });
        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(12px)';
            setTimeout(function() { if(toast.parentNode) toast.remove(); }, 400);
        }, 2800);
    };
})();

// =========== CART COUNT GLOBAL UPDATER ===========
window.updateCartCount = function(count) {
    document.querySelectorAll('.cart-count-badge').forEach(function(el) {
        el.textContent = count;
        el.style.display = count > 0 ? 'inline-block' : 'none';
    });
};

// =========== CSRF TOKEN: COOKIE FALLBACK ===========
window.getCsrfToken = function() {
    var input = document.querySelector("[name='csrfmiddlewaretoken']");
    if (input) return input.value;
    var m = document.cookie.match(/csrftoken=([^;]+)/);
    return m ? m[1] : '';
};
</script>
<script defer>
    
  var availableTags = [
    {% for a in search_data %}
      "{{ a.product_name|truncatechars:55 }}",
    {% endfor %}
  ];

  function mainsearch_fut() {
    let sear_vl = document.getElementById("searchbar_fullwebsite").value.toLowerCase()
    let tag_text = availableTags.filter(item => item.toLowerCase().includes(sear_vl))
    let ul = document.getElementById("big_searvhbar_fullwebsite")
    ul.innerHTML = ""

    if (sear_vl.length <= 0) {
      ul.style.display = "none"
    } else {
      ul.style.display = "block"
    }

    tag_text.forEach((elm) => {
      let new_li = document.createElement("li");
      new_li.className = "list-group-item d-flex align-items-center";

      let icon = document.createElement("i");
      icon.className = "fa fa-search me-2";
      new_li.appendChild(icon);

      new_li.appendChild(document.createTextNode(elm));
      ul.appendChild(new_li);

      new_li.addEventListener("click", () => {
        const searchTerm = elm.replace(/["]+/g, '');
        window.location.href = "/shop?searchbar=" + searchTerm
      });
    })
  }
  
  
  
  
  function mainsearch_fut_phone() {
    let sear_vl = document.getElementById("searchbar_fullwebsite_phone").value.toLowerCase()
    let tag_text = availableTags.filter(item => item.toLowerCase().includes(sear_vl))
    let ul = document.getElementById("big_searvhbar_fullwebsite_phone")
    ul.innerHTML = ""

    if (sear_vl.length <= 0) {
      ul.style.display = "none"
    } else {
      ul.style.display = "block"
    }

    tag_text.forEach((elm) => {
      let new_li = document.createElement("li");
      new_li.className = "list-group-item d-flex align-items-center";

      let icon = document.createElement("i");
      icon.className = "fa fa-search me-2";
      new_li.appendChild(icon);

      new_li.appendChild(document.createTextNode(elm));
      ul.appendChild(new_li);

      new_li.addEventListener("click", () => {
        const searchTerm = elm.replace(/["]+/g, '');
        window.location.href = "/shop?searchbar=" + searchTerm
      });
    })
  }
</script>


    {% block footer %}{% endblock footer %}

<script>
// ===== MEGA MENU: Delay-based hover to prevent gap flicker =====
(function() {
    var navItem = document.getElementById('collectionsNavItem');
    var megaMenu = document.getElementById('collectionsMegaMenu');
    if (!navItem || !megaMenu) return;

    var hideTimeout;
    var HIDE_DELAY = 120; // ms — enough time to move mouse into the menu

    function showMenu() {
        clearTimeout(hideTimeout);
        megaMenu.style.opacity = '1';
        megaMenu.style.visibility = 'visible';
        megaMenu.style.transform = 'translateY(0)';
        megaMenu.style.pointerEvents = 'auto';
    }

    function hideMenu() {
        hideTimeout = setTimeout(function() {
            megaMenu.style.opacity = '0';
            megaMenu.style.visibility = 'hidden';
            megaMenu.style.transform = 'translateY(10px)';
            megaMenu.style.pointerEvents = 'none';
        }, HIDE_DELAY);
    }

    // Nav item (trigger link)
    navItem.addEventListener('mouseenter', showMenu);
    navItem.addEventListener('mouseleave', hideMenu);

    // Mega menu panel itself — cancel hide when entering the panel
    megaMenu.addEventListener('mouseenter', function() {
        clearTimeout(hideTimeout);
    });
    megaMenu.addEventListener('mouseleave', hideMenu);
})();
</script>

</body>

</html>