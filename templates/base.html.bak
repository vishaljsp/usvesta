  <script>
document.addEventListener("DOMContentLoaded", () => {
    const currentPath = window.location.pathname;

    // Hide SEO accordion on homepage — breaks luxury aesthetic
    const seoAccordion = document.getElementById("seo-accordion-wrapper");
    if (seoAccordion && (currentPath === "/" || currentPath === "/index.html" || currentPath === "")) {
        seoAccordion.remove();
    } else if (seoAccordion) {
        seoAccordion.classList.remove("d-none");
    }

    // jaha footer remove karna hai
    const removeFooterPages = [
        "/profile",
        "/checkout",
    ];
    const path = window.location.pathname;

    if (path.includes("/products/")) {
        document.querySelector("footer")?.remove();
    }

    if (removeFooterPages.includes(currentPath)) {
        document.querySelector("footer")?.remove();
    }
});
</script>  
